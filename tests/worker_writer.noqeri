import "../Database/noesql_engine.noqeri"

function main(): void {
    let dbPath: string = "tmp_concurrent_db"
    let db: NoeDatabaseState
    noeEngineInit(&db, "concurrent_test")

    let tIdx: isize = noeCreateTable(&db, "events")
    noeAddField(&db, tIdx as usize, "id", noeTypeInt(), true, true, true, true, "")
    noeAddField(&db, tIdx as usize, "data", noeTypeInt(), true, false, false, false, "")

    // Perform repeated write transactions under advisory file locking
    let i: usize = 0 as usize
    while i < 10 as usize {
        let r: [NoeRowCell; 2]
        r[0].isNull = true
        r[1].isNull = false
        r[1].intVal = (i * 10 as usize) as i64
        noeInsertRow(&db, tIdx as usize, slice(r))
        noeDbSaveV3(&db, dbPath)
        i = i + 1 as usize
    }
    print("WRITER_COMPLETE")
}

main()
