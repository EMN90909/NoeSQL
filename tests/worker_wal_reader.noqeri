import "../Database/noesql_wal_engine.noqeri"

function main(): void {
    let dbPath: string = "tmp_concurrent_wal_db"

    let engine: NoeWalEngine
    let openRes: isize = noeWalEngineOpen(&engine, dbPath)
    if openRes != 0 as isize {
        print("OPEN_FAILED:" + intToString(openRes as i64))
        return
    }

    let tIdx: isize = noeFindTable(&engine.db, "events")
    if tIdx < 0 as isize {
        file_close(engine.walFd)
        file_close(engine.lockFd)
        print("TABLE_NOT_FOUND")
        return
    }

    let t: *NoeTableData = &engine.db.tables[tIdx as usize]
    print("TOTAL_RECOVERED_ROWS:" + intToString(t.rowCount as i64))

    let r: usize = 0 as usize
    while r < t.rowCount {
        let cell: *NoeRowCell = &t.cells[r * 16 as usize + 1 as usize]
        if !cell.isNull {
            print("RECOVERED_ROW_VAL:" + intToString(cell.intVal))
        }
        r = r + 1 as usize
    }

    file_close(engine.walFd)
    file_close(engine.lockFd)
    print("WAL_READER_COMPLETE")
}

main()
