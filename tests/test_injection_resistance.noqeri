import "../Database/noesql_engine.noqeri"

function assert_true(cond: bool, msg: string): void {
    if !cond {
        print("ASSERTION FAILED: " + msg)
        let trap: *u8 = 0 as *u8
        print(trap[0])
    }
}

function main(): void {
    print("=== Testing Query Injection Resistance (Bound Parameters & Literal Typing) ===")

    let db: NoeDatabaseState
    noeEngineInit(&db, "injection_test")

    // 1. Create table via statement execution
    let ddlRes: isize = noeExecuteStatement(&db, "table users { id: int key auto, username: text required unique, role: text }")
    assert_true(ddlRes == 0 as isize, "DDL statement execution creates users table")

    // 2. Insert legitimate user via statement execution
    let ins1: isize = noeExecuteStatement(&db, "users add { username: \"alice\", role: \"user\" }")
    assert_true(ins1 == 0 as isize, "insert alice via statement")

    // 3. Insert hostile SQL injection payloads via statement execution
    // Payload A: Classic tautology: ' OR '1'='1
    let ins2: isize = noeExecuteStatement(&db, "users add { username: \"' OR '1'='1\", role: \"guest\" }")
    assert_true(ins2 == 0 as isize, "insert tautology payload via statement")

    // Payload B: Stacked statement drop: '; DROP TABLE users; --
    let ins3: isize = noeExecuteStatement(&db, "users add { username: \"hacker'; DROP TABLE users; --\", role: \"attacker\" }")
    assert_true(ins3 == 0 as isize, "insert drop-table payload via statement")

    // Payload C: Union comment injection: admin' --
    let ins4: isize = noeExecuteStatement(&db, "users add { username: \"admin' --\", role: \"probe\" }")
    assert_true(ins4 == 0 as isize, "insert comment payload via statement")

    // 4. Verify table still exists and wasn't dropped by '; DROP TABLE users; --'
    assert_true(noeFindTable(&db, "users") == 0 as isize, "table 'users' remains intact and was not dropped")
    assert_true(db.tables[0].rowCount == 4 as usize, "all 4 rows parsed and stored safely as literals")

    // 5. Query execution injection test: Targeted deletion using exact literal equality
    // Delete specifically the tautology row
    let delRes: isize = noeExecuteStatement(&db, "users where username == \"' OR '1'='1\" delete")
    assert_true(delRes == 0 as isize, "delete tautology row statement")
    assert_true(db.tables[0].rowCount == 3 as usize, "only the single tautology row was deleted")

    // 6. Verify remaining rows were NOT deleted by tautology
    assert_true(db.tables[0].cells[1].textVal == "alice", "alice remains untouched")
    assert_true(db.tables[0].cells[16 + 1].textVal == "hacker'; DROP TABLE users; --", "drop table payload remains literal")
    assert_true(db.tables[0].cells[32 + 1].textVal == "admin' --", "admin comment remains literal")

    // 7. Targeted update using statement execution
    let updRes: isize = noeExecuteStatement(&db, "users where username == \"alice\" set role = \"superadmin\"")
    assert_true(updRes == 0 as isize, "update alice role via statement")
    assert_true(db.tables[0].cells[2].textVal == "superadmin", "alice role successfully updated to superadmin")

    print("Query Injection Resistance (Bound Parameters & Literal Typing): ALL PASSED")
}

main()
