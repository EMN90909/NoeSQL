import "../Database/noesql_engine.noqeri"
import "../../Noqeri/Lib/std/file.noqeri"
import "../../Noqeri/Lib/std/fs.noqeri"

function assert_true(cond: bool, msg: string): void {
    if !cond {
        print("ASSERTION FAILED: " + msg)
        let trap: *u8 = 0 as *u8
        print(trap[0])
    }
}

function main(): void {
    print("=== Testing Power-loss Durability, fsync, and Cold Recovery ===")

    let dbPath: string = "tmp_durability_test_db"
    fs_remove_tree(dbPath)
    fs_remove(dbPath + ".lck")

    // Generation 1: Initialize accounts table with balance=1000
    let db: NoeDatabaseState
    noeEngineInit(&db, "durability_test")

    let tIdx: isize = noeCreateTable(&db, "accounts")
    assert_true(tIdx >= 0 as isize, "create accounts table")
    noeAddField(&db, tIdx as usize, "id", noeTypeInt(), true, true, true, true, "")
    noeAddField(&db, tIdx as usize, "balance", noeTypeInt(), true, false, false, false, "")

    let r1: [NoeRowCell; 2]
    r1[0].isNull = true // auto
    r1[1].isNull = false
    r1[1].intVal = 1000 as i64
    assert_true(noeInsertRow(&db, tIdx as usize, slice(r1)) == 0 as isize, "insert row 1")

    assert_true(noeDbSaveV3(&db, dbPath) == 0 as isize, "commit generation 1")
    assert_true(fs_exists(dbPath + "/versions/generation-1.pages"), "immutable generation-1.pages exists")

    // Generation 2: Insert second row with balance=2500
    let r2: [NoeRowCell; 2]
    r2[0].isNull = true // auto
    r2[1].isNull = false
    r2[1].intVal = 2500 as i64
    assert_true(noeInsertRow(&db, tIdx as usize, slice(r2)) == 0 as isize, "insert row 2")

    assert_true(noeDbSaveV3(&db, dbPath) == 0 as isize, "commit generation 2")
    assert_true(fs_exists(dbPath + "/versions/generation-2.pages"), "immutable generation-2.pages exists")
    // Invariant: generation-1.pages MUST still exist (immutable snapshots)
    assert_true(fs_exists(dbPath + "/versions/generation-1.pages"), "generation-1.pages preserved immutably")

    // Cold Reopening into a completely fresh uninitialized memory state
    let coldDb: NoeDatabaseState
    assert_true(noeDbOpenV3(&coldDb, dbPath) == 0 as isize, "cold reopen generation 2 from disk")
    assert_true(coldDb.generation == 2 as u64, "active generation is 2")
    assert_true(coldDb.tables[0].rowCount == 2 as usize, "reconstructed 2 accounts")
    assert_true(coldDb.tables[0].cells[0 * 16 as usize + 1 as usize].intVal == 1000 as i64, "row 1 balance is 1000")
    assert_true(coldDb.tables[0].cells[1 * 16 as usize + 1 as usize].intVal == 2500 as i64, "row 2 balance is 2500")

    // SIMULATE POWER LOSS / PARTIAL COMMIT INTERRUPT:
    // Create an uncommitted partial HEAD.tmp representing a crash before atomic commit
    let crashTmp: string = dbPath + "/HEAD.tmp"
    let tmpH: isize = file_open_replace(crashTmp)
    let garbage: [u8; 8] = [255 as u8, 255 as u8, 255 as u8, 255 as u8, 255 as u8, 255 as u8, 255 as u8, 255 as u8]
    file_write_all(tmpH as usize, slice(garbage))
    file_close(tmpH as usize)

    // Cold recovery check:
    // Database must fail-closed back to the verified durable Generation 2 and reconstruct exact data
    let recoveredDb: NoeDatabaseState
    assert_true(noeDbOpenV3(&recoveredDb, dbPath) == 0 as isize, "recovery verifies existing durable HEAD despite crash marker")
    assert_true(recoveredDb.tables[0].cells[0 * 16 as usize + 1 as usize].intVal == 1000 as i64, "recovered row 1 intact")
    assert_true(recoveredDb.tables[0].cells[1 * 16 as usize + 1 as usize].intVal == 2500 as i64, "recovered row 2 intact")

    // Clean up
    fs_remove_tree(dbPath)
    fs_remove(dbPath + ".lck")

    print("Power-loss Durability, fsync, and Cold Recovery: ALL PASSED")
}

main()
