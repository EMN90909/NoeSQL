{
  "name": "noesql",
  "version": "0.7.6",
  "private": false,
  "type": "module",
  "description": "NoeSQL 0.7.6 experimental SQLite/reference APIs and isolated Zig pager; compiled native Noqeri relational integration not qualified",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test",
    "test:reference": "node --test",
    "test:cpp-bridge": "make -C Native/cpp test",
    "test:native": "make -C Native/cpp test-native",
    "test:embedded": "node --test tests/noesql-advanced.test.mjs tests/noesql-sqlite-durability.test.mjs tests/noesql-web.test.mjs tests/noesql-embedded-integration.test.mjs",
    "smoke": "node Runtime/noesql-cli.mjs",
    "benchmark:policy": "echo Native Noqeri compiler required; no benchmark results claimed",
    "benchmark:reference": "node Benchmarks/reference-relational.mjs 250",
    "benchmark:native": "make -C Native/cpp benchmark",
    "benchmark:sqlite": "make -C Native/cpp benchmark-compare",
    "benchmark:embedded": "node Benchmarks/embedded-vs-sqlite.mjs 10000 3000",
    "example:web": "node Examples/embedded-web.mjs",
    "test:zig": "cd Native/zig && zig build test",
    "test:noedb": "node --test tests/noesql-zig-pages.test.mjs tests/noesql-migrate-noedb.test.mjs tests/noesql-format-recovery.test.mjs tests/noesql-wal-sequence.test.mjs tests/noesql-large-noedb.test.mjs tests/noesql-native-acid-matrix.test.mjs",
    "test:zig-page-roundtrip": "node scripts/verify-zig-page-roundtrip.mjs",
    "build:zig": "cd Native/zig && zig build -Doptimize=ReleaseSafe",
    "qualify:zig": "node scripts/qualify-zig.mjs",
    "verify:noqeri": "node scripts/verify-noqeri-bootstrap.mjs",
    "benchmark:zig-v2": "bash scripts/benchmark-zig-v2.sh",
    "pack:inspect": "npm pack --dry-run --json",
    "test:component-contract": "node --test tests/noesql-076-release-contract.test.mjs",
    "qualify:native-e2e": "node scripts/verify-native-e2e.mjs",
    "test:npm-pack": "node scripts/test-npm-package.mjs",
    "test:native-contract": "node --test tests/noesql-native-contract.test.mjs",
    "test:npm-contract": "node --test tests/noesql-npm-package.test.mjs",
    "prepublishOnly": "node scripts/release-preflight.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "test:release-contract": "node --test tests/noesql-release-preflight.test.mjs",
    "benchmark:relational-baseline": "node Benchmarks/qualify-relational-benchmark.mjs --sqlite-only --transactions=200 --repeats=7",
    "benchmark:relational-compare": "node Benchmarks/qualify-relational-benchmark.mjs --transactions=200 --repeats=7",
    "test:relational-benchmark": "node --test tests/noesql-relational-benchmark.test.mjs",
    "build:native-link": "node scripts/build-noqeri-zig-link.mjs",
    "test:native-link-contract": "node --test tests/noesql-native-link.test.mjs tests/noesql-native-artifact-contract.test.mjs",
    "test:query-planner": "node --test tests/noesql-query-planner.test.mjs tests/noesql-query-plan-integration.test.mjs",
    "test:readonly-fastpath": "node --test tests/noesql-readonly-fastpath.test.mjs",
    "test:native-index-contract": "node --test tests/noesql-native-index-contract.test.mjs",
    "benchmark:read-path": "node Benchmarks/read-path-profile.mjs 1000 7",
    "test:read-path-profile": "node --test tests/noesql-read-path-profile.test.mjs"
  },
  "exports": {
    ".": "./Runtime/noesql-embedded.mjs",
    "./embedded": "./Runtime/noesql-embedded.mjs",
    "./reference": "./Runtime/noesql-reference.mjs",
    "./relational": "./Runtime/noesql-relational.mjs",
    "./cli": "./Runtime/noesql-cli.mjs"
  },
  "bin": {
    "noesql": "./Runtime/noesql-cli.mjs"
  },
  "files": [
    "Runtime/",
    "Database/",
    "Native/zig/",
    "Grammar/",
    "Doc/",
    "README.md",
    "VERSION",
    "LICENSE"
  ],
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EMN90909/NoeSQL.git"
  },
  "homepage": "https://github.com/EMN90909/NoeSQL#readme",
  "bugs": {
    "url": "https://github.com/EMN90909/NoeSQL/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "tag": "next"
  }
}
