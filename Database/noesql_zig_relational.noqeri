module noqeri.database.noesql.zig_relational
import "noesql_api.noqeri"
import "noesql_executor.noqeri"
import "noesql_row.noqeri"
import "noesql_pager_abi.noqeri"

// Native Rust/Noqeri/Zig boundary. One request pointer is used deliberately:
// the current Noqeri x86-64 AOT backend supports six register arguments, while
// the relational operation naturally needs more state.
record NoeZigExecutionRequest {
    path: string
    pageId: u32
    ctx: *NoeQueryContext
    plan: *NoeIrPlan
    columns: []NoeColumn
    insertRow: []NoeValue
    projections: []usize
    output: []NoeValue
    result: *NoeExecutionResult
}

export function noeZigSingleRowExecute(req: *NoeZigExecutionRequest): isize {
    if req == null || req.result == null || req.ctx == null || req.plan == null { return -210 as isize }
    req.result.affected = 0 as usize
    req.result.returned = 0 as usize
    req.result.rowCount = 0 as usize

    if req.pageId == 0 as u32 || !noePagerBounds(req.pageId,noePagerPageBytes()) { return -211 as isize }
    if len(req.columns) != 2 as usize { return -212 as isize }
    if req.columns[0].kind != noeTypeInt() || req.columns[1].kind != noeTypeBool() { return -213 as isize }

    let pool: [u8; 1] = [0 as u8]
    let verified: isize = noeApiValidate(req.ctx,req.plan,req.columns,slice(pool),req.projections)
    if verified < 0 as isize { return verified }
    if req.plan.operation == noePlanInsert() && len(req.insertRow) != 2 as usize { return -214 as isize }

    let handle: usize = 0 as usize
    let opened: int = noesql_zig_page_open(noePagerAbiVersion(),req.path,&handle)
    if opened != 0 || !noePagerValidHandle(handle) { return -215 as isize }

    let record: [u8; 4096]
    let i: usize = 0 as usize
    while i < 4096 as usize { record[i] = 0 as u8 i = i + 1 as usize }

    let got: int = noesql_zig_page_get(handle,req.pageId,&record[0],noePagerPageBytes())
    if got != 0 && got != 1 { noesql_zig_page_close(handle) return -216 as isize }

    let present: bool = got == 0
    if present {
        if record[0] == 0 as u8 && record[1] == 0 as u8 &&
           record[2] == 0 as u8 && record[3] == 0 as u8 {
            let allZero: bool = true
            let pos: usize = 0 as usize
            while pos < 4096 as usize {
                if record[pos] != 0 as u8 { allZero = false }
                pos = pos + 1 as usize
            }
            if !allZero { noesql_zig_page_close(handle) return -222 as isize }
            present = false
        }
    }

    let original: [NoeValue; 4]
    let scratch: [NoeValue; 4]
    let rowCount: usize = 0 as usize
    if present {
        let decoded: [NoeValue; 2]
        let used: usize = 0 as usize
        let decodedStatus: isize = noeRowDecode(slice(record),req.columns,req.ctx.schemaVersion,slice(decoded),slice(pool),&used)
        if decodedStatus < 0 as isize { noesql_zig_page_close(handle) return -217 as isize }
        original[0] = decoded[0]
        original[1] = decoded[1]
        rowCount = 1 as usize
    }

    let draft: NoeExecutionResult
    let execution: NoeExecutionRequest
    execution.plan = req.plan
    execution.columns = req.columns
    execution.original = slice(original)
    execution.scratch = slice(scratch)
    execution.rowCount = rowCount
    execution.insertRow = req.insertRow
    execution.projections = req.projections
    execution.output = req.output
    execution.bytes = slice(pool)
    execution.version = req.ctx.schemaVersion
    execution.result = &draft

    let status: isize = noeExecute(&execution)
    if status < 0 as isize { noesql_zig_page_close(handle) return status }

    if req.plan.operation == noePlanGet() || draft.affected == 0 as usize {
        req.result.affected = draft.affected
        req.result.returned = draft.returned
        req.result.rowCount = draft.rowCount
        noesql_zig_page_close(handle)
        return 0 as isize
    }

    i = 0 as usize
    while i < 4096 as usize { record[i] = 0 as u8 i = i + 1 as usize }
    if draft.rowCount == 1 as usize {
        let one: [NoeValue; 2]
        one[0] = original[0]
        one[1] = original[1]
        let encoded: isize = noeRowEncode(req.columns,slice(one),slice(pool),req.ctx.schemaVersion,slice(record))
        if encoded < 0 as isize { noesql_zig_page_close(handle) return -218 as isize }
    } else if draft.rowCount != 0 as usize {
        noesql_zig_page_close(handle)
        return -219 as isize
    }

    if noesql_zig_page_stage(handle,req.pageId,&record[0],noePagerPageBytes()) != 0 {
        noesql_zig_page_rollback(handle)
        noesql_zig_page_close(handle)
        return -220 as isize
    }
    if noesql_zig_page_commit(handle) != 0 {
        noesql_zig_page_rollback(handle)
        noesql_zig_page_close(handle)
        return -221 as isize
    }

    req.result.affected = draft.affected
    req.result.returned = draft.returned
    req.result.rowCount = draft.rowCount
    noesql_zig_page_close(handle)
    return 0 as isize
}
