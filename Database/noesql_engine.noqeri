module noqeri.database.noesql.engine

import "noesql_ir.noqeri"
import "noesql_row.noqeri"
import "noesql_wal.noqeri"
import "noesql_auth.noqeri"
import "noesql_limits.noqeri"
import "noesql_isolation.noqeri"
import "../../Noqeri/Lib/std/file.noqeri"
import "../../Noqeri/Lib/std/fs.noqeri"

extern function stringToBytes(s: string, dst: *u8, maxLen: usize): usize
extern function bytesToString(src: *u8, len: usize): string
extern function intToString(val: i64): string

export function noeIntToString(val: i64): string {
    return intToString(val)
}

// ============================================================================
// NoeSQL Pure Noqeri Database Engine
// Full relational schema, CRUD, foreign keys, query execution, and durable v3 persistence.
// ============================================================================

export function noeEngineVersion(): string {
    return "0.9.5-pure-noqeri"
}

// ----------------------------------------------------------------------------
// Low-Level Endian-Aware Binary Serialization Helpers
// ----------------------------------------------------------------------------

function noeWriteU8(h: usize, val: u8): isize {
    let b: [u8; 1] = [val]
    return file_write_all(h, slice(b))
}

function noeReadU8(h: usize, outVal: *u8): isize {
    let b: [u8; 1] = [0 as u8]
    let n: isize = file_read_exact(h, slice(b))
    if n <= 0 as isize { return n }
    outVal[0] = b[0]
    return 1 as isize
}

function noeWriteU32(h: usize, val: u32): isize {
    let b: [u8; 4] = [
        (val % 256 as u32) as u8,
        ((val / 256 as u32) % 256 as u32) as u8,
        ((val / 65536 as u32) % 256 as u32) as u8,
        ((val / 16777216 as u32) % 256 as u32) as u8
    ]
    return file_write_all(h, slice(b))
}

function noeReadU32(h: usize, outVal: *u32): isize {
    let b: [u8; 4] = [0 as u8, 0 as u8, 0 as u8, 0 as u8]
    let n: isize = file_read_exact(h, slice(b))
    if n <= 0 as isize { return n }
    outVal[0] = (b[0] as u32) +
                ((b[1] as u32) * 256 as u32) +
                ((b[2] as u32) * 65536 as u32) +
                ((b[3] as u32) * 16777216 as u32)
    return 4 as isize
}

function noeWriteI64(h: usize, val: i64): isize {
    let u: u64 = val as u64
    let b: [u8; 8]
    let i: usize = 0 as usize
    while i < 8 as usize {
        b[i] = (u % 256 as u64) as u8
        u = u / 256 as u64
        i = i + 1 as usize
    }
    return file_write_all(h, slice(b))
}

function noeReadI64(h: usize, outVal: *i64): isize {
    let b: [u8; 8]
    let n: isize = file_read_exact(h, slice(b))
    if n <= 0 as isize { return n }
    let u: u64 = 0 as u64
    let mult: u64 = 1 as u64
    let i: usize = 0 as usize
    while i < 8 as usize {
        u = u + (b[i] as u64) * mult
        mult = mult * 256 as u64
        i = i + 1 as usize
    }
    outVal[0] = u as i64
    return 8 as isize
}

function noeWriteString(h: usize, str: string): isize {
    let lenBytes: [u8; 512]
    let strLen: usize = stringToBytes(str, &lenBytes[0], 512 as usize)
    let w32: isize = noeWriteU32(h, strLen as u32)
    if w32 < 0 as isize { return w32 }
    if strLen == 0 as usize { return 0 as isize }
    return file_write_all(h, slice(lenBytes, strLen))
}

function noeReadString(h: usize): string {
    let st: isize = 0 as isize
    return noeReadStringChecked(h, &st)
}

function noeReadStringChecked(h: usize, outStatus: *isize): string {
    outStatus[0] = 0 as isize
    let lenU32: u32 = 0 as u32
    let r32: isize = noeReadU32(h, &lenU32)
    if r32 < 0 as isize {
        outStatus[0] = r32
        return ""
    }
    if r32 == 0 as isize {
        outStatus[0] = -2 as isize
        return ""
    }
    if lenU32 > 512 as u32 {
        outStatus[0] = -50 as isize // Corrupted string length
        return ""
    }
    if lenU32 == 0 as u32 {
        return ""
    }
    let buf: [u8; 512]
    let n: isize = file_read_exact(h, slice(buf, lenU32 as usize))
    if n < 0 as isize {
        outStatus[0] = n
        return ""
    }
    return bytesToString(&buf[0], lenU32 as usize)
}

// ----------------------------------------------------------------------------
// Schema and Data Representation
// ----------------------------------------------------------------------------

record NoeFieldDef {
    name: string
    kind: int        // 1=int, 2=text, 3=bool, 4=float, 5=decimal
    required: bool
    unique: bool
    isKey: bool
    auto: bool
    hasDefault: bool
    defaultInt: i64
    defaultText: string
    defaultBool: bool
    refTable: string
}

record NoeRowCell {
    isNull: bool
    intVal: i64
    textVal: string
    boolVal: bool
}

record NoeTableData {
    name: string
    fieldCount: usize
    fields: [NoeFieldDef; 16]
    autoSequence: i64
    rowCount: usize
    // Flattened row cells: cellIndex = rowIndex * 16 + colIndex
    cells: [NoeRowCell; 8192]
}

record NoeDatabaseState {
    name: string
    tableCount: usize
    tables: [NoeTableData; 16]
    generation: u64
    inTransaction: bool
    lastTxId: u64
}

// ----------------------------------------------------------------------------
// Database Initialization & Table Management
// ----------------------------------------------------------------------------

export function noeEngineInit(db: *NoeDatabaseState, dbName: string): void {
    db.name = dbName
    db.tableCount = 0 as usize
    db.generation = 1 as u64
    db.inTransaction = false
    db.lastTxId = 0 as u64
}

export function noeFindTable(db: *NoeDatabaseState, name: string): isize {
    let i: usize = 0 as usize
    while i < db.tableCount {
        if db.tables[i].name == name {
            return i as isize
        }
        i = i + 1 as usize
    }
    return -1 as isize
}

export function noeFindField(db: *NoeDatabaseState, tableIdx: usize, fieldName: string): isize {
    let t: *NoeTableData = &db.tables[tableIdx]
    let i: usize = 0 as usize
    while i < t.fieldCount {
        if t.fields[i].name == fieldName {
            return i as isize
        }
        i = i + 1 as usize
    }
    return -1 as isize
}

export function noeCreateTable(db: *NoeDatabaseState, name: string): isize {
    if noeFindTable(db, name) >= 0 as isize {
        return -1 as isize // Table already exists
    }
    if db.tableCount >= 16 as usize {
        return -2 as isize // Max tables reached
    }
    let idx: usize = db.tableCount
    db.tables[idx].name = name
    db.tables[idx].fieldCount = 0 as usize
    db.tables[idx].autoSequence = 1 as i64
    db.tables[idx].rowCount = 0 as usize
    db.tableCount = db.tableCount + 1 as usize
    return idx as isize
}

export function noeAddField(db: *NoeDatabaseState, tableIdx: usize, fieldName: string, kind: int, req: bool, unq: bool, key: bool, autoInc: bool, refTab: string): isize {
    let t: *NoeTableData = &db.tables[tableIdx]
    if t.fieldCount >= 16 as usize {
        return -1 as isize
    }
    let fIdx: usize = t.fieldCount
    t.fields[fIdx].name = fieldName
    t.fields[fIdx].kind = kind
    t.fields[fIdx].required = req
    t.fields[fIdx].unique = unq
    t.fields[fIdx].isKey = key
    t.fields[fIdx].auto = autoInc
    t.fields[fIdx].hasDefault = false
    t.fields[fIdx].defaultInt = 0 as i64
    t.fields[fIdx].defaultText = ""
    t.fields[fIdx].defaultBool = false
    t.fields[fIdx].refTable = refTab
    t.fieldCount = t.fieldCount + 1 as usize
    return fIdx as isize
}

export function noeSetFieldDefaultInt(db: *NoeDatabaseState, tableIdx: usize, fieldIdx: usize, val: i64): void {
    db.tables[tableIdx].fields[fieldIdx].hasDefault = true
    db.tables[tableIdx].fields[fieldIdx].defaultInt = val
}

export function noeSetFieldDefaultBool(db: *NoeDatabaseState, tableIdx: usize, fieldIdx: usize, val: bool): void {
    db.tables[tableIdx].fields[fieldIdx].hasDefault = true
    db.tables[tableIdx].fields[fieldIdx].defaultBool = val
}

export function noeSetFieldDefaultText(db: *NoeDatabaseState, tableIdx: usize, fieldIdx: usize, val: string): void {
    db.tables[tableIdx].fields[fieldIdx].hasDefault = true
    db.tables[tableIdx].fields[fieldIdx].defaultText = val
}

// ----------------------------------------------------------------------------
// Foreign Key Enforcement
// ----------------------------------------------------------------------------

export function noeValidateForeignKey(db: *NoeDatabaseState, tableIdx: usize, fieldIdx: usize, cell: *NoeRowCell): isize {
    let t: *NoeTableData = &db.tables[tableIdx]
    let f: *NoeFieldDef = &t.fields[fieldIdx]
    if f.refTable == "" {
        return 0 as isize
    }
    if cell.isNull {
        if f.required {
            return -201 as isize // NOE201: required FK cannot be null
        }
        return 0 as isize // Nullable FK allowed
    }

    let targetIdx: isize = noeFindTable(db, f.refTable)
    if targetIdx < 0 as isize {
        return -204 as isize // NOE204: unknown reference table
    }

    let target: *NoeTableData = &db.tables[targetIdx as usize]
    let targetKeyCol: isize = -1 as isize
    let i: usize = 0 as usize
    while i < target.fieldCount {
        if target.fields[i].isKey {
            targetKeyCol = i as isize
            break
        }
        i = i + 1 as usize
    }

    if targetKeyCol < 0 as isize {
        return -205 as isize // NOE205: reference target has no key
    }

    // Search target table for matching key value
    let found: bool = false
    let r: usize = 0 as usize
    while r < target.rowCount {
        let targetCell: *NoeRowCell = &target.cells[r * 16 as usize + targetKeyCol as usize]
        if !targetCell.isNull && targetCell.intVal == cell.intVal {
            found = true
            break
        }
        r = r + 1 as usize
    }

    if !found {
        return -205 as isize // NOE205: foreign key refers to missing row
    }
    return 0 as isize
}

export function noeCheckDeleteBlockedByReference(db: *NoeDatabaseState, tableIdx: usize, primaryKeyVal: i64): isize {
    let tableName: string = db.tables[tableIdx].name

    let tIdx: usize = 0 as usize
    while tIdx < db.tableCount {
        let other: *NoeTableData = &db.tables[tIdx]
        let fIdx: usize = 0 as usize
        while fIdx < other.fieldCount {
            if other.fields[fIdx].refTable == tableName {
                let r: usize = 0 as usize
                while r < other.rowCount {
                    let cell: *NoeRowCell = &other.cells[r * 16 as usize + fIdx]
                    if !cell.isNull && cell.intVal == primaryKeyVal {
                        return -208 as isize // NOE208: delete blocked by foreign key reference
                    }
                    r = r + 1 as usize
                }
            }
            fIdx = fIdx + 1 as usize
        }
        tIdx = tIdx + 1 as usize
    }
    return 0 as isize
}

// ----------------------------------------------------------------------------
// Row Operations: Insert, Update, Delete
// ----------------------------------------------------------------------------

export function noeInsertRow(db: *NoeDatabaseState, tableIdx: usize, rowVals: []NoeRowCell): isize {
    let t: *NoeTableData = &db.tables[tableIdx]
    if t.rowCount >= 512 as usize {
        return -101 as isize // Table capacity reached
    }

    let rIdx: usize = t.rowCount
    let nextSeq: i64 = t.autoSequence

    // 1. Populate auto-increment and default values, and check constraints
    let col: usize = 0 as usize
    while col < t.fieldCount {
        let f: *NoeFieldDef = &t.fields[col]
        let destCell: *NoeRowCell = &t.cells[rIdx * 16 as usize + col]

        if col < len(rowVals) && !rowVals[col].isNull {
            destCell[0] = rowVals[col]
        } else if f.auto {
            destCell.isNull = false
            destCell.intVal = nextSeq
            destCell.textVal = ""
            destCell.boolVal = false
            nextSeq = nextSeq + 1 as i64
        } else if f.hasDefault {
            destCell.isNull = false
            destCell.intVal = f.defaultInt
            destCell.textVal = f.defaultText
            destCell.boolVal = f.defaultBool
        } else {
            destCell.isNull = true
            destCell.intVal = 0 as i64
            destCell.textVal = ""
            destCell.boolVal = false
        }

        // Required constraint check
        if f.required && destCell.isNull {
            return -202 as isize // NOE202: missing required field
        }

        // Unique / Key constraint check
        if (f.unique || f.isKey) && !destCell.isNull {
            let scanR: usize = 0 as usize
            while scanR < rIdx {
                let existing: *NoeRowCell = &t.cells[scanR * 16 as usize + col]
                if !existing.isNull {
                    if f.kind == noeTypeInt() && existing.intVal == destCell.intVal {
                        return -203 as isize // NOE203: duplicate unique value
                    }
                    if f.kind == noeTypeText() && existing.textVal == destCell.textVal {
                        return -203 as isize // NOE203: duplicate unique value
                    }
                }
                scanR = scanR + 1 as usize
            }
        }

        // Foreign key constraint check
        let fkStatus: isize = noeValidateForeignKey(db, tableIdx, col, destCell)
        if fkStatus < 0 as isize {
            return fkStatus
        }

        col = col + 1 as usize
    }

    t.autoSequence = nextSeq
    t.rowCount = rIdx + 1 as usize
    return 0 as isize
}

export function noeDeleteRow(db: *NoeDatabaseState, tableIdx: usize, rowIdx: usize): isize {
    let t: *NoeTableData = &db.tables[tableIdx]
    if rowIdx >= t.rowCount {
        return -1 as isize
    }

    let keyCol: isize = -1 as isize
    let i: usize = 0 as usize
    while i < t.fieldCount {
        if t.fields[i].isKey {
            keyCol = i as isize
            break
        }
        i = i + 1 as usize
    }

    if keyCol >= 0 as isize {
        let keyVal: i64 = t.cells[rowIdx * 16 as usize + keyCol as usize].intVal
        let blockStatus: isize = noeCheckDeleteBlockedByReference(db, tableIdx, keyVal)
        if blockStatus < 0 as isize {
            return blockStatus
        }
    }

    // Shift remaining rows down
    let curr: usize = rowIdx
    while curr + 1 as usize < t.rowCount {
        let c: usize = 0 as usize
        while c < 16 as usize {
            t.cells[curr * 16 as usize + c] = t.cells[(curr + 1 as usize) * 16 as usize + c]
            c = c + 1 as usize
        }
        curr = curr + 1 as usize
    }
    t.rowCount = t.rowCount - 1 as usize
    return 0 as isize
}

// ----------------------------------------------------------------------------
// v3 On-Disk Persistence: Genuine Binary Serialization & Cold Reopening
// ----------------------------------------------------------------------------

function noeReadActiveGeneration(dbPath: string): u64 {
    let headPath: string = dbPath + "/HEAD"
    let h: isize = file_open_read(headPath)
    if h < 0 as isize { return 0 as u64 }
    let buf: [u8; 32]
    let n: isize = file_read_into(h as usize, slice(buf))
    file_close(h as usize)
    if n <= 0 as isize { return 0 as u64 }

    let gen: u64 = 0 as u64
    let i: usize = 0 as usize
    while i < n as usize && buf[i] >= 48 as u8 && buf[i] <= 57 as u8 {
        gen = gen * (10 as u64) + ((buf[i] - 48 as u8) as u64)
        i = i + 1 as usize
    }
    return gen
}

export function noeDbSaveV3(db: *NoeDatabaseState, dbPath: string): isize {
    // Fault injection check
    if fs_exists(dbPath + "/.noesql_testing_faults_enabled") && fs_exists(dbPath + "/FAULT_SNAPSHOT_SAVE_FAIL.flag") {
        return -25 as isize
    }

    // 1. Ensure database directories exist
    let dirOk: isize = fs_ensure_directory(dbPath)
    if dirOk < 0 as isize { return dirOk }
    let versionsDir: string = dbPath + "/versions"
    let vDirOk: isize = fs_ensure_directory(versionsDir)
    if vDirOk < 0 as isize { return vDirOk }

    // 2. Open and acquire cross-process advisory lock
    let lockPath: string = dbPath + ".lck"
    let lockHandle: isize = file_open_create(lockPath)
    if lockHandle < 0 as isize { return lockHandle }
    let lockOk: isize = file_lock(lockHandle as usize, true)
    if lockOk < 0 as isize {
        file_close(lockHandle as usize)
        return -1001 as isize // Lock contention
    }

    // 3. Advance to new immutable generation
    let currentGen: u64 = noeReadActiveGeneration(dbPath)
    let nextGen: u64 = currentGen + (1 as u64)
    db.generation = nextGen

    // Generation snapshot path: versions/generation-<gen>.pages
    let genFile: string = versionsDir + "/generation-" + intToString(nextGen as i64) + ".pages"
    let genHandle: isize = file_open_replace(genFile)
    if genHandle < 0 as isize {
        file_unlock(lockHandle as usize)
        file_close(lockHandle as usize)
        return genHandle
    }

    // 4. Serialize NQDB0003 Header (32 bytes)
    // Magic: "NQDB0003"
    let magic: [u8; 8] = [78 as u8, 81 as u8, 68 as u8, 66 as u8, 48 as u8, 48 as u8, 48 as u8, 51 as u8]
    let wMagic: isize = file_write_all(genHandle as usize, slice(magic))
    if wMagic < 0 as isize { file_close(genHandle as usize); file_unlock(lockHandle as usize); file_close(lockHandle as usize); return wMagic }
    if noeWriteI64(genHandle as usize, nextGen as i64) < 0 as isize { file_close(genHandle as usize); file_unlock(lockHandle as usize); file_close(lockHandle as usize); return -20 as isize }
    if noeWriteU32(genHandle as usize, db.tableCount as u32) < 0 as isize { file_close(genHandle as usize); file_unlock(lockHandle as usize); file_close(lockHandle as usize); return -21 as isize }
    if noeWriteI64(genHandle as usize, db.lastTxId as i64) < 0 as isize { file_close(genHandle as usize); file_unlock(lockHandle as usize); file_close(lockHandle as usize); return -22 as isize }
    if noeWriteU32(genHandle as usize, 0 as u32) < 0 as isize { file_close(genHandle as usize); file_unlock(lockHandle as usize); file_close(lockHandle as usize); return -23 as isize }

    // 5. Serialize Tables, Field Definitions, and Actual Rows
    let tIdx: usize = 0 as usize
    while tIdx < db.tableCount {
        let t: *NoeTableData = &db.tables[tIdx]
        if noeWriteString(genHandle as usize, t.name) < 0 as isize { file_close(genHandle as usize); file_unlock(lockHandle as usize); file_close(lockHandle as usize); return -30 as isize }
        if noeWriteU32(genHandle as usize, t.fieldCount as u32) < 0 as isize { file_close(genHandle as usize); file_unlock(lockHandle as usize); file_close(lockHandle as usize); return -31 as isize }
        if noeWriteI64(genHandle as usize, t.autoSequence) < 0 as isize { file_close(genHandle as usize); file_unlock(lockHandle as usize); file_close(lockHandle as usize); return -32 as isize }
        if noeWriteU32(genHandle as usize, t.rowCount as u32) < 0 as isize { file_close(genHandle as usize); file_unlock(lockHandle as usize); file_close(lockHandle as usize); return -33 as isize }

        // Serialize fields
        let fIdx: usize = 0 as usize
        while fIdx < t.fieldCount {
            let f: *NoeFieldDef = &t.fields[fIdx]
            if noeWriteString(genHandle as usize, f.name) < 0 as isize { file_close(genHandle as usize); file_unlock(lockHandle as usize); file_close(lockHandle as usize); return -34 as isize }
            if noeWriteU32(genHandle as usize, f.kind as u32) < 0 as isize { file_close(genHandle as usize); file_unlock(lockHandle as usize); file_close(lockHandle as usize); return -35 as isize }
            let reqB: u8 = 0 as u8
            if f.required { reqB = 1 as u8 }
            if noeWriteU8(genHandle as usize, reqB) < 0 as isize { file_close(genHandle as usize); file_unlock(lockHandle as usize); file_close(lockHandle as usize); return -36 as isize }

            let unqB: u8 = 0 as u8
            if f.unique { unqB = 1 as u8 }
            if noeWriteU8(genHandle as usize, unqB) < 0 as isize { file_close(genHandle as usize); file_unlock(lockHandle as usize); file_close(lockHandle as usize); return -37 as isize }

            let keyB: u8 = 0 as u8
            if f.isKey { keyB = 1 as u8 }
            if noeWriteU8(genHandle as usize, keyB) < 0 as isize { file_close(genHandle as usize); file_unlock(lockHandle as usize); file_close(lockHandle as usize); return -38 as isize }

            let autoB: u8 = 0 as u8
            if f.auto { autoB = 1 as u8 }
            if noeWriteU8(genHandle as usize, autoB) < 0 as isize { file_close(genHandle as usize); file_unlock(lockHandle as usize); file_close(lockHandle as usize); return -39 as isize }

            let defB: u8 = 0 as u8
            if f.hasDefault { defB = 1 as u8 }
            if noeWriteU8(genHandle as usize, defB) < 0 as isize { file_close(genHandle as usize); file_unlock(lockHandle as usize); file_close(lockHandle as usize); return -40 as isize }

            if noeWriteI64(genHandle as usize, f.defaultInt) < 0 as isize { file_close(genHandle as usize); file_unlock(lockHandle as usize); file_close(lockHandle as usize); return -41 as isize }

            let defBoolB: u8 = 0 as u8
            if f.defaultBool { defBoolB = 1 as u8 }
            if noeWriteU8(genHandle as usize, defBoolB) < 0 as isize { file_close(genHandle as usize); file_unlock(lockHandle as usize); file_close(lockHandle as usize); return -42 as isize }

            if noeWriteString(genHandle as usize, f.refTable) < 0 as isize { file_close(genHandle as usize); file_unlock(lockHandle as usize); file_close(lockHandle as usize); return -43 as isize }
            fIdx = fIdx + 1 as usize
        }

        // Serialize rows & cells
        let rIdx: usize = 0 as usize
        while rIdx < t.rowCount {
            let cIdx: usize = 0 as usize
            while cIdx < t.fieldCount {
                let cell: *NoeRowCell = &t.cells[rIdx * 16 as usize + cIdx]
                let nullB: u8 = 0 as u8
                if cell.isNull { nullB = 1 as u8 }
                if noeWriteU8(genHandle as usize, nullB) < 0 as isize { file_close(genHandle as usize); file_unlock(lockHandle as usize); file_close(lockHandle as usize); return -44 as isize }

                if !cell.isNull {
                    let kind: int = t.fields[cIdx].kind
                    if kind == noeTypeInt() {
                        if noeWriteI64(genHandle as usize, cell.intVal) < 0 as isize { file_close(genHandle as usize); file_unlock(lockHandle as usize); file_close(lockHandle as usize); return -45 as isize }
                    } else if kind == noeTypeBool() {
                        let bVal: u8 = 0 as u8
                        if cell.boolVal { bVal = 1 as u8 }
                        if noeWriteU8(genHandle as usize, bVal) < 0 as isize { file_close(genHandle as usize); file_unlock(lockHandle as usize); file_close(lockHandle as usize); return -46 as isize }
                    } else if kind == noeTypeText() {
                        if noeWriteString(genHandle as usize, cell.textVal) < 0 as isize { file_close(genHandle as usize); file_unlock(lockHandle as usize); file_close(lockHandle as usize); return -47 as isize }
                    }
                }
                cIdx = cIdx + 1 as usize
            }
            rIdx = rIdx + 1 as usize
        }
        tIdx = tIdx + 1 as usize
    }

    // 6. Fsync and compute authentic SHA-256 checksum over entire snapshot payload
    let syncPages: isize = file_sync(genHandle as usize)
    file_close(genHandle as usize)
    if syncPages < 0 as isize {
        file_unlock(lockHandle as usize)
        file_close(lockHandle as usize)
        return syncPages
    }

    let snapReadHandle: isize = file_open_read(genFile)
    if snapReadHandle < 0 as isize {
        file_unlock(lockHandle as usize)
        file_close(lockHandle as usize)
        return snapReadHandle
    }
    let snapSizeIs: isize = file_size(snapReadHandle as usize)
    if snapSizeIs < 0 as isize {
        file_close(snapReadHandle as usize)
        file_unlock(lockHandle as usize)
        file_close(lockHandle as usize)
        return snapSizeIs
    }
    let snapSize: usize = snapSizeIs as usize
    let snapDigest: [u8; 32]
    let sdi: usize = 0 as usize
    while sdi < 32 as usize { snapDigest[sdi] = 0 as u8 sdi = sdi + 1 as usize }
    let readChunk: [u8; 2048]
    let hashedOff: usize = 0 as usize
    while hashedOff < snapSize {
        let toRead: usize = snapSize - hashedOff
        if toRead > 2048 as usize { toRead = 2048 as usize }
        let nRead: isize = file_read_exact(snapReadHandle as usize, slice(&readChunk[0], toRead))
        if nRead < 0 as isize {
            file_close(snapReadHandle as usize)
            file_unlock(lockHandle as usize)
            file_close(lockHandle as usize)
            return -48 as isize
        }
        noeWalChainHash(&snapDigest[0], &readChunk[0], toRead, &snapDigest[0])
        hashedOff = hashedOff + toRead
    }
    file_close(snapReadHandle as usize)

    // Append 32-byte SHA-256 checksum trailer
    let snapAppHandle: isize = file_open_append(genFile)
    if snapAppHandle < 0 as isize {
        file_unlock(lockHandle as usize)
        file_close(lockHandle as usize)
        return snapAppHandle
    }
    let wChk: isize = file_write_all(snapAppHandle as usize, slice(snapDigest))
    if wChk < 0 as isize {
        file_close(snapAppHandle as usize)
        file_unlock(lockHandle as usize)
        file_close(lockHandle as usize)
        return -49 as isize
    }
    let syncTrailer: isize = file_sync(snapAppHandle as usize)
    file_close(snapAppHandle as usize)
    if syncTrailer < 0 as isize {
        file_unlock(lockHandle as usize)
        file_close(lockHandle as usize)
        return syncTrailer
    }

    // Fsync versions directory to persist generation file creation
    let vSync: isize = fs_directory_sync(versionsDir)
    if vSync < 0 as isize {
        file_unlock(lockHandle as usize)
        file_close(lockHandle as usize)
        return vSync
    }

    // 7. Atomic HEAD commit: write to HEAD.tmp, fsync, then atomic rename
    let headTmp: string = dbPath + "/HEAD.tmp"
    let headFinal: string = dbPath + "/HEAD"
    let headHandle: isize = file_open_replace(headTmp)
    if headHandle < 0 as isize {
        file_unlock(lockHandle as usize)
        file_close(lockHandle as usize)
        return headHandle
    }
    let genStr: string = intToString(nextGen as i64) + "\n"
    let genBuf: [u8; 64]
    let genBytes: usize = stringToBytes(genStr, &genBuf[0], 64 as usize)
    let wHead: isize = file_write_all(headHandle as usize, slice(genBuf, genBytes))
    if wHead < 0 as isize {
        file_close(headHandle as usize)
        file_unlock(lockHandle as usize)
        file_close(lockHandle as usize)
        return wHead
    }
    if fs_exists(dbPath + "/.noesql_testing_faults_enabled") && fs_exists(dbPath + "/FAULT_HEAD_SYNC_FAIL.flag") {
        file_close(headHandle as usize)
        file_unlock(lockHandle as usize)
        file_close(lockHandle as usize)
        return -26 as isize // Injected HEAD sync failure
    }
    let syncHead: isize = file_sync(headHandle as usize)
    file_close(headHandle as usize)
    if syncHead < 0 as isize {
        file_unlock(lockHandle as usize)
        file_close(lockHandle as usize)
        return syncHead
    }

    // Atomic replace rename without pre-removing destination
    let mvOk: isize = fs_move_replace(headTmp, headFinal)
    if mvOk < 0 as isize {
        file_unlock(lockHandle as usize)
        file_close(lockHandle as usize)
        return mvOk
    }

    // 8. Directory synchronization
    let dSync: isize = fs_directory_sync(dbPath)
    if dSync < 0 as isize {
        file_unlock(lockHandle as usize)
        file_close(lockHandle as usize)
        return dSync
    }

    // 9. Release lock
    file_unlock(lockHandle as usize)
    file_close(lockHandle as usize)
    return 0 as isize
}

export function noeDbCheckV3(db: *NoeDatabaseState, dbPath: string): isize {
    let currentGen: u64 = noeReadActiveGeneration(dbPath)
    if currentGen == 0 as u64 {
        return -1 as isize // Missing or invalid HEAD
    }

    let genFile: string = dbPath + "/versions/generation-" + intToString(currentGen as i64) + ".pages"
    if !fs_exists(genFile) {
        return -2 as isize // Missing generation pages file
    }

    let h: isize = file_open_read(genFile)
    if h < 0 as isize { return -3 as isize }

    let fSizeIs: isize = file_size(h as usize)
    if fSizeIs < 64 as isize {
        file_close(h as usize)
        return -83 as isize // Undersized file: missing mandatory 32-byte checksum trailer for NQDB0003
    }

    let buf: [u8; 8]
    let n: isize = file_read_exact(h as usize, slice(buf))
    file_close(h as usize)
    if n != 8 as isize { return -4 as isize }

    // Check NQDB0003
    if buf[0] != 78 as u8 || buf[1] != 81 as u8 || buf[2] != 68 as u8 || buf[3] != 66 as u8 ||
       buf[4] != 48 as u8 || buf[5] != 48 as u8 || buf[6] != 48 as u8 || buf[7] != 51 as u8 {
        return -5 as isize // Bad magic
    }
    return 0 as isize // Verified
}

// ----------------------------------------------------------------------------
// Cold Reopening: Full Disk-to-Memory Reconstruction
// ----------------------------------------------------------------------------

export function noeDbOpenV3(db: *NoeDatabaseState, dbPath: string): isize {
    let check: isize = noeDbCheckV3(db, dbPath)
    if check < 0 as isize { return check }

    let currentGen: u64 = noeReadActiveGeneration(dbPath)
    let genFile: string = dbPath + "/versions/generation-" + intToString(currentGen as i64) + ".pages"
    let h: isize = file_open_read(genFile)
    if h < 0 as isize { return h }

    let fSizeIs: isize = file_size(h as usize)
    if fSizeIs < 64 as isize {
        file_close(h as usize)
        return -83 as isize // Undersized file: missing mandatory 32-byte checksum trailer for NQDB0003
    }
    let fSize: usize = fSizeIs as usize
    let payloadSize: usize = fSize - 32 as usize

        // Read stored 32-byte checksum from the end of the file
        if file_seek(h as usize, payloadSize as i64, 0) < 0 as isize {
            file_close(h as usize)
            return -84 as isize
        }
        let storedDigest: [u8; 32]
        let rStored: isize = file_read_exact(h as usize, slice(storedDigest))
        if rStored < 0 as isize {
            file_close(h as usize)
            return -84 as isize
        }

        // Rewind and compute authentic rolling SHA-256 over payload
        file_seek(h as usize, 0 as i64, 0)
        let compDigest: [u8; 32]
        let cdi: usize = 0 as usize
        while cdi < 32 as usize { compDigest[cdi] = 0 as u8 cdi = cdi + 1 as usize }
        let vChunk: [u8; 2048]
        let vOff: usize = 0 as usize
        while vOff < payloadSize {
            let vToRead: usize = payloadSize - vOff
            if vToRead > 2048 as usize { vToRead = 2048 as usize }
            let rV: isize = file_read_exact(h as usize, slice(&vChunk[0], vToRead))
            if rV < 0 as isize {
                file_close(h as usize)
                return -85 as isize
            }
            noeWalChainHash(&compDigest[0], &vChunk[0], vToRead, &compDigest[0])
            vOff = vOff + vToRead
        }

        // Verify computed checksum matches stored checksum
        let chkFail: bool = false
        let mi: usize = 0 as usize
        while mi < 32 as usize {
            if compDigest[mi] != storedDigest[mi] { chkFail = true }
            mi = mi + 1 as usize
        }
        if chkFail {
            file_close(h as usize)
            return -83 as isize // Snapshot checksum verification failed!
        }

        // Rewind to 0 to proceed with deserialization
        file_seek(h as usize, 0 as i64, 0)

    // Skip magic (8 bytes)
    let magicBuf: [u8; 8]
    let rMagic: isize = file_read_exact(h as usize, slice(magicBuf))
    if rMagic < 0 as isize {
        file_close(h as usize)
        return -60 as isize // Failed to read magic
    }

    let genI64: i64 = 0 as i64
    let rGen: isize = noeReadI64(h as usize, &genI64)
    if rGen < 0 as isize {
        file_close(h as usize)
        return -61 as isize // Failed to read generation
    }
    db.generation = genI64 as u64

    let tableCountU32: u32 = 0 as u32
    let rTc: isize = noeReadU32(h as usize, &tableCountU32)
    if rTc < 0 as isize {
        file_close(h as usize)
        return -62 as isize // Failed to read table count
    }
    if tableCountU32 > 16 as u32 {
        file_close(h as usize)
        return -6 as isize // Corrupted table count
    }
    db.tableCount = tableCountU32 as usize
    db.inTransaction = false

    // Read lastTxId (8 bytes) + 4 bytes padding
    let lastTxI64: i64 = 0 as i64
    let rTx: isize = noeReadI64(h as usize, &lastTxI64)
    if rTx < 0 as isize {
        file_close(h as usize)
        return -63 as isize // Failed to read lastTxId
    }
    db.lastTxId = lastTxI64 as u64

    let padU32: u32 = 0 as u32
    let rPad: isize = noeReadU32(h as usize, &padU32)
    if rPad < 0 as isize {
        file_close(h as usize)
        return -64 as isize // Failed to read padding
    }

    // Deserialize each table
    let tIdx: usize = 0 as usize
    while tIdx < db.tableCount {
        let t: *NoeTableData = &db.tables[tIdx]
        let rNameSt: isize = 0 as isize
        t.name = noeReadStringChecked(h as usize, &rNameSt)
        if rNameSt < 0 as isize {
            file_close(h as usize)
            return -65 as isize // Failed to read table name
        }

        let fieldCountU32: u32 = 0 as u32
        let rFc: isize = noeReadU32(h as usize, &fieldCountU32)
        if rFc < 0 as isize {
            file_close(h as usize)
            return -66 as isize // Failed to read field count
        }
        if fieldCountU32 > 16 as u32 {
            file_close(h as usize)
            return -7 as isize // Corrupted field count
        }
        t.fieldCount = fieldCountU32 as usize

        let autoSeqI64: i64 = 0 as i64
        let rSeq: isize = noeReadI64(h as usize, &autoSeqI64)
        if rSeq < 0 as isize {
            file_close(h as usize)
            return -67 as isize // Failed to read auto sequence
        }
        t.autoSequence = autoSeqI64

        let rowCountU32: u32 = 0 as u32
        let rRc: isize = noeReadU32(h as usize, &rowCountU32)
        if rRc < 0 as isize {
            file_close(h as usize)
            return -68 as isize // Failed to read row count
        }
        if rowCountU32 > 512 as u32 {
            file_close(h as usize)
            return -8 as isize // Corrupted row count
        }
        t.rowCount = rowCountU32 as usize

        // Deserialize fields
        let fIdx: usize = 0 as usize
        while fIdx < t.fieldCount {
            let f: *NoeFieldDef = &t.fields[fIdx]
            let rFnameSt: isize = 0 as isize
            f.name = noeReadStringChecked(h as usize, &rFnameSt)
            if rFnameSt < 0 as isize { file_close(h as usize) return -69 as isize }

            let kindU32: u32 = 0 as u32
            let rKind: isize = noeReadU32(h as usize, &kindU32)
            if rKind < 0 as isize { file_close(h as usize) return -70 as isize }
            f.kind = kindU32 as int

            let reqU8: u8 = 0 as u8
            let rReq: isize = noeReadU8(h as usize, &reqU8)
            if rReq < 0 as isize { file_close(h as usize) return -71 as isize }
            f.required = (reqU8 != 0 as u8)

            let unqU8: u8 = 0 as u8
            let rUnq: isize = noeReadU8(h as usize, &unqU8)
            if rUnq < 0 as isize { file_close(h as usize) return -72 as isize }
            f.unique = (unqU8 != 0 as u8)

            let keyU8: u8 = 0 as u8
            let rKey: isize = noeReadU8(h as usize, &keyU8)
            if rKey < 0 as isize { file_close(h as usize) return -73 as isize }
            f.isKey = (keyU8 != 0 as u8)

            let autoU8: u8 = 0 as u8
            let rAuto: isize = noeReadU8(h as usize, &autoU8)
            if rAuto < 0 as isize { file_close(h as usize) return -74 as isize }
            f.auto = (autoU8 != 0 as u8)

            let hasDefU8: u8 = 0 as u8
            let rHasDef: isize = noeReadU8(h as usize, &hasDefU8)
            if rHasDef < 0 as isize { file_close(h as usize) return -75 as isize }
            f.hasDefault = (hasDefU8 != 0 as u8)

            let defIntI64: i64 = 0 as i64
            let rDefInt: isize = noeReadI64(h as usize, &defIntI64)
            if rDefInt < 0 as isize { file_close(h as usize) return -76 as isize }
            f.defaultInt = defIntI64

            let defBoolU8: u8 = 0 as u8
            let rDefBool: isize = noeReadU8(h as usize, &defBoolU8)
            if rDefBool < 0 as isize { file_close(h as usize) return -77 as isize }
            f.defaultBool = (defBoolU8 != 0 as u8)

            let rRefSt: isize = 0 as isize
            f.refTable = noeReadStringChecked(h as usize, &rRefSt)
            if rRefSt < 0 as isize { file_close(h as usize) return -78 as isize }

            fIdx = fIdx + 1 as usize
        }

        // Deserialize rows and cells
        let rIdx: usize = 0 as usize
        while rIdx < t.rowCount {
            let cIdx: usize = 0 as usize
            while cIdx < t.fieldCount {
                let cell: *NoeRowCell = &t.cells[rIdx * 16 as usize + cIdx]
                let isNullU8: u8 = 0 as u8
                let rNull: isize = noeReadU8(h as usize, &isNullU8)
                if rNull < 0 as isize { file_close(h as usize) return -79 as isize }
                cell.isNull = (isNullU8 != 0 as u8)

                if !cell.isNull {
                    let kind: int = t.fields[cIdx].kind
                    if kind == noeTypeInt() {
                        let iVal: i64 = 0 as i64
                        let rI: isize = noeReadI64(h as usize, &iVal)
                        if rI < 0 as isize { file_close(h as usize) return -80 as isize }
                        cell.intVal = iVal
                        cell.textVal = ""
                        cell.boolVal = false
                    } else if kind == noeTypeBool() {
                        let bVal: u8 = 0 as u8
                        let rB: isize = noeReadU8(h as usize, &bVal)
                        if rB < 0 as isize { file_close(h as usize) return -81 as isize }
                        cell.boolVal = (bVal != 0 as u8)
                        cell.intVal = 0 as i64
                        cell.textVal = ""
                    } else if kind == noeTypeText() {
                        let rTextSt: isize = 0 as isize
                        cell.textVal = noeReadStringChecked(h as usize, &rTextSt)
                        if rTextSt < 0 as isize { file_close(h as usize) return -82 as isize }
                        cell.intVal = 0 as i64
                        cell.boolVal = false
                    }
                } else {
                    cell.intVal = 0 as i64
                    cell.textVal = ""
                    cell.boolVal = false
                }
                cIdx = cIdx + 1 as usize
            }
            rIdx = rIdx + 1 as usize
        }
        tIdx = tIdx + 1 as usize
    }

    file_close(h as usize)
    return 0 as isize // Successfully reconstructed
}

// ----------------------------------------------------------------------------
// Backup and Restore (Point-in-Time Recovery)
// ----------------------------------------------------------------------------

export function noeDbBackup(db: *NoeDatabaseState, srcPath: string, backupPath: string): isize {
    let check: isize = noeDbCheckV3(db, srcPath)
    if check < 0 as isize {
        return check // Source database corrupted or incomplete
    }
    fs_ensure_directory(backupPath)
    fs_ensure_directory(backupPath + "/versions")

    let currentGen: u64 = noeReadActiveGeneration(srcPath)
    let genFileName: string = "/versions/generation-" + intToString(currentGen as i64) + ".pages"

    // Copy active HEAD and its corresponding generation pages
    fs_copy_file_replace(srcPath + "/HEAD", backupPath + "/HEAD")
    fs_copy_file_replace(srcPath + genFileName, backupPath + genFileName)
    fs_directory_sync(backupPath)
    return 0 as isize
}

export function noeDbRestore(db: *NoeDatabaseState, backupPath: string, targetPath: string): isize {
    let check: isize = noeDbCheckV3(db, backupPath)
    if check < 0 as isize {
        return check // Backup is invalid
    }
    let copyOk: isize = noeDbBackup(db, backupPath, targetPath)
    if copyOk < 0 as isize { return copyOk }

    // Reconstruct target database into memory to guarantee restoration parity
    return noeDbOpenV3(db, targetPath)
}

// ----------------------------------------------------------------------------
// Statement Tokenizer and Statement Dispatcher
// ----------------------------------------------------------------------------

function noeIsSpace(c: u8): bool {
    return c == 32 as u8 || c == 9 as u8 || c == 10 as u8 || c == 13 as u8
}

function noeParseToken(buf: *u8, len: usize, cur: *usize): string {
    while cur[0] < len && noeIsSpace(buf[cur[0]]) {
        cur[0] = cur[0] + 1 as usize
    }
    if cur[0] >= len { return "" }
    let c: u8 = buf[cur[0]]

    // Skip // comments
    if c == 47 as u8 && cur[0] + 1 as usize < len && buf[cur[0] + 1 as usize] == 47 as u8 {
        while cur[0] < len && buf[cur[0]] != 10 as u8 {
            cur[0] = cur[0] + 1 as usize
        }
        return noeParseToken(buf, len, cur)
    }

    if c == 34 as u8 {
        // Quoted string literal
        cur[0] = cur[0] + 1 as usize
        let start: usize = cur[0]
        while cur[0] < len && buf[cur[0]] != 34 as u8 {
            cur[0] = cur[0] + 1 as usize
        }
        let tokLen: usize = cur[0] - start
        if cur[0] < len && buf[cur[0]] == 34 as u8 {
            cur[0] = cur[0] + 1 as usize
        }
        return bytesToString(&buf[start], tokLen)
    }

    if c == 123 as u8 || c == 125 as u8 || c == 58 as u8 || c == 44 as u8 || c == 40 as u8 || c == 41 as u8 || c == 59 as u8 {
        let start: usize = cur[0]
        cur[0] = cur[0] + 1 as usize
        return bytesToString(&buf[start], 1 as usize)
    }

    if c == 61 as u8 {
        let start: usize = cur[0]
        cur[0] = cur[0] + 1 as usize
        if cur[0] < len && buf[cur[0]] == 61 as u8 {
            cur[0] = cur[0] + 1 as usize
            return "=="
        }
        return "="
    }

    let start: usize = cur[0]
    while cur[0] < len && !noeIsSpace(buf[cur[0]]) && buf[cur[0]] != 34 as u8 &&
          buf[cur[0]] != 123 as u8 && buf[cur[0]] != 125 as u8 && buf[cur[0]] != 58 as u8 &&
          buf[cur[0]] != 44 as u8 && buf[cur[0]] != 61 as u8 && buf[cur[0]] != 40 as u8 &&
          buf[cur[0]] != 41 as u8 && buf[cur[0]] != 59 as u8 {
        cur[0] = cur[0] + 1 as usize
    }
    return bytesToString(&buf[start], cur[0] - start)
}

export function noeParseI64(str: string): i64 {
    let buf: [u8; 32]
    let n: usize = stringToBytes(str, &buf[0], 32 as usize)
    if n == 0 as usize { return 0 as i64 }
    let sign: i64 = 1 as i64
    let start: usize = 0 as usize
    if buf[0] == 45 as u8 {
        sign = -1 as i64
        start = 1 as usize
    }
    let res: i64 = 0 as i64
    let i: usize = start
    while i < n {
        if buf[i] >= 48 as u8 && buf[i] <= 57 as u8 {
            res = res * (10 as i64) + ((buf[i] - 48 as u8) as i64)
        } else {
            break
        }
        i = i + 1 as usize
    }
    return res * sign
}

export function noeExecuteStatement(db: *NoeDatabaseState, line: string): isize {
    let buf: [u8; 1024]
    let lineLen: usize = stringToBytes(line, &buf[0], 1024 as usize)
    if lineLen == 0 as usize { return 0 as isize }

    let cur: usize = 0 as usize
    let firstTok: string = noeParseToken(&buf[0], lineLen, &cur)
    if firstTok == "" || firstTok == ";" { return 0 as isize }

    if firstTok == "db" {
        let dbName: string = noeParseToken(&buf[0], lineLen, &cur)
        if dbName != "" {
            db.name = dbName
        }
        return 0 as isize
    }

    if firstTok == "table" {
        let tblName: string = noeParseToken(&buf[0], lineLen, &cur)
        if tblName == "" { return -1 as isize }
        let tIdx: isize = noeCreateTable(db, tblName)
        if tIdx < 0 as isize { return tIdx }

        let openBrace: string = noeParseToken(&buf[0], lineLen, &cur)
        while cur < lineLen {
            let fName: string = noeParseToken(&buf[0], lineLen, &cur)
            if fName == "" || fName == "}" { break }
            if fName == "," { continue }
            let colon: string = noeParseToken(&buf[0], lineLen, &cur)
            let fType: string = noeParseToken(&buf[0], lineLen, &cur)
            let kind: int = noeTypeInt()
            if fType == "text" { kind = noeTypeText() }
            else if fType == "bool" { kind = noeTypeBool() }

            let req: bool = false
            let unq: bool = false
            let isK: bool = false
            let isA: bool = false
            let hasD: bool = false
            let dInt: i64 = 0 as i64
            let dBool: bool = false

            while cur < lineLen {
                let modTok: string = noeParseToken(&buf[0], lineLen, &cur)
                if modTok == "" || modTok == "," || modTok == "}" {
                    if modTok == "}" { cur = lineLen }
                    break
                }
                if modTok == "required" { req = true }
                else if modTok == "unique" { unq = true }
                else if modTok == "key" { isK = true; req = true }
                else if modTok == "auto" { isA = true; req = true }
                else if modTok == "=" {
                    let defVal: string = noeParseToken(&buf[0], lineLen, &cur)
                    hasD = true
                    if kind == noeTypeInt() { dInt = noeParseI64(defVal) }
                    else if kind == noeTypeBool() { dBool = (defVal == "true") }
                }
            }
            noeAddField(db, tIdx as usize, fName, kind, req, unq, isK, isA, "")
            if hasD {
                let fCount: usize = db.tables[tIdx as usize].fieldCount
                db.tables[tIdx as usize].fields[fCount - 1 as usize].hasDefault = true
                db.tables[tIdx as usize].fields[fCount - 1 as usize].defaultInt = dInt
                db.tables[tIdx as usize].fields[fCount - 1 as usize].defaultBool = dBool
            }
        }
        return 0 as isize
    }

    if firstTok == "index" || firstTok == "query" {
        return 0 as isize
    }

    // Otherwise, firstTok is table name
    let tIdx: isize = noeFindTable(db, firstTok)
    if tIdx < 0 as isize {
        return -1 as isize // Unknown table
    }
    let t: *NoeTableData = &db.tables[tIdx as usize]

    let actionTok: string = noeParseToken(&buf[0], lineLen, &cur)
    if actionTok == "add" {
        let openBrace: string = noeParseToken(&buf[0], lineLen, &cur)
        let rowCells: [NoeRowCell; 16]
        let c: usize = 0 as usize
        while c < t.fieldCount {
            rowCells[c].isNull = true
            rowCells[c].intVal = 0 as i64
            rowCells[c].textVal = ""
            rowCells[c].boolVal = false
            if t.fields[c].hasDefault {
                rowCells[c].isNull = false
                rowCells[c].intVal = t.fields[c].defaultInt
                rowCells[c].boolVal = t.fields[c].defaultBool
            }
            c = c + 1 as usize
        }

        while cur < lineLen {
            let colName: string = noeParseToken(&buf[0], lineLen, &cur)
            if colName == "" || colName == "}" { break }
            if colName == "," { continue }
            let sep: string = noeParseToken(&buf[0], lineLen, &cur)
            let valStr: string = noeParseToken(&buf[0], lineLen, &cur)

            let colIdx: isize = -1 as isize
            let f: usize = 0 as usize
            while f < t.fieldCount {
                if t.fields[f].name == colName {
                    colIdx = f as isize
                    break
                }
                f = f + 1 as usize
            }

            if colIdx >= 0 as isize {
                rowCells[colIdx as usize].isNull = false
                let k: int = t.fields[colIdx as usize].kind
                if k == noeTypeInt() {
                    rowCells[colIdx as usize].intVal = noeParseI64(valStr)
                } else if k == noeTypeBool() {
                    rowCells[colIdx as usize].boolVal = (valStr == "true")
                } else if k == noeTypeText() {
                    rowCells[colIdx as usize].textVal = valStr
                }
            }
        }
        return noeInsertRow(db, tIdx as usize, slice(rowCells, t.fieldCount))
    }

    if actionTok == "get" {
        return 0 as isize
    }

    if actionTok == "where" {
        let condCol: string = noeParseToken(&buf[0], lineLen, &cur)
        let opEq: string = noeParseToken(&buf[0], lineLen, &cur)
        let condVal: string = noeParseToken(&buf[0], lineLen, &cur)
        let nextVerb: string = noeParseToken(&buf[0], lineLen, &cur)

        let colIdx: isize = -1 as isize
        let f: usize = 0 as usize
        while f < t.fieldCount {
            if t.fields[f].name == condCol {
                colIdx = f as isize
                break
            }
            f = f + 1 as usize
        }
        if colIdx < 0 as isize { return -1 as isize }

        if nextVerb == "delete" {
            let r: usize = 0 as usize
            while r < t.rowCount {
                let cell: *NoeRowCell = &t.cells[r * 16 as usize + colIdx as usize]
                let matchCond: bool = false
                if !cell.isNull {
                    if t.fields[colIdx as usize].kind == noeTypeInt() && cell.intVal == noeParseI64(condVal) {
                        matchCond = true
                    } else if t.fields[colIdx as usize].kind == noeTypeText() && cell.textVal == condVal {
                        matchCond = true
                    }
                }
                if matchCond {
                    let delRes: isize = noeDeleteRow(db, tIdx as usize, r)
                    if delRes < 0 as isize { return delRes }
                } else {
                    r = r + 1 as usize
                }
            }
            return 0 as isize
        }

        if nextVerb == "set" {
            let setCol: string = noeParseToken(&buf[0], lineLen, &cur)
            let eqTok: string = noeParseToken(&buf[0], lineLen, &cur)
            let setVal: string = noeParseToken(&buf[0], lineLen, &cur)

            let setIdx: isize = -1 as isize
            let sf: usize = 0 as usize
            while sf < t.fieldCount {
                if t.fields[sf].name == setCol {
                    setIdx = sf as isize
                    break
                }
                sf = sf + 1 as usize
            }
            if setIdx < 0 as isize { return -1 as isize }

            let r: usize = 0 as usize
            while r < t.rowCount {
                let cell: *NoeRowCell = &t.cells[r * 16 as usize + colIdx as usize]
                let matchCond: bool = false
                if !cell.isNull {
                    if t.fields[colIdx as usize].kind == noeTypeInt() && cell.intVal == noeParseI64(condVal) {
                        matchCond = true
                    } else if t.fields[colIdx as usize].kind == noeTypeText() && cell.textVal == condVal {
                        matchCond = true
                    }
                }
                if matchCond {
                    let targetCell: *NoeRowCell = &t.cells[r * 16 as usize + setIdx as usize]
                    targetCell.isNull = false
                    if t.fields[setIdx as usize].kind == noeTypeInt() {
                        targetCell.intVal = noeParseI64(setVal)
                    } else if t.fields[setIdx as usize].kind == noeTypeBool() {
                        targetCell.boolVal = (setVal == "true")
                    } else if t.fields[setIdx as usize].kind == noeTypeText() {
                        targetCell.textVal = setVal
                    }
                }
                r = r + 1 as usize
            }
            return 0 as isize
        }
    }

    return 0 as isize
}

// ----------------------------------------------------------------------------
// RBAC Security & Multi-Tenant Authorized CRUD Execution
// ----------------------------------------------------------------------------

export function noeExecuteSecured(db: *NoeDatabaseState, principal: *NoePrincipal, opType: int, scope: u64): isize {
    if !noeAuthenticated(principal) {
        return -401 as isize // Unauthorized / unauthenticated
    }
    if !noeOperationPermit(principal, opType, scope) {
        return -403 as isize // Forbidden: insufficient RBAC role
    }
    return 0 as isize
}

export function noeSecuredInsertRow(db: *NoeDatabaseState, principal: *NoePrincipal, scope: u64, tableIdx: usize, row: []NoeRowCell): isize {
    let authRes: isize = noeExecuteSecured(db, principal, 2, scope)
    if authRes < 0 as isize { return authRes }
    return noeInsertRow(db, tableIdx, row)
}

export function noeSecuredDeleteRow(db: *NoeDatabaseState, principal: *NoePrincipal, scope: u64, tableIdx: usize, rowIdx: usize): isize {
    let authRes: isize = noeExecuteSecured(db, principal, 4, scope)
    if authRes < 0 as isize { return authRes }
    return noeDeleteRow(db, tableIdx, rowIdx)
}

export function noeSecuredSelectCell(db: *NoeDatabaseState, principal: *NoePrincipal, scope: u64, tableIdx: usize, rowIdx: usize, colIdx: usize): *NoeRowCell {
    let authRes: isize = noeExecuteSecured(db, principal, 1, scope)
    if authRes < 0 as isize { return null }
    if tableIdx >= db.tableCount || rowIdx >= db.tables[tableIdx].rowCount || colIdx >= db.tables[tableIdx].fieldCount {
        return null
    }
    return &db.tables[tableIdx].cells[rowIdx * 16 as usize + colIdx]
}

export function noeSecuredUpdateCell(db: *NoeDatabaseState, principal: *NoePrincipal, scope: u64, tableIdx: usize, rowIdx: usize, colIdx: usize, val: NoeRowCell): isize {
    let authRes: isize = noeExecuteSecured(db, principal, 3, scope)
    if authRes < 0 as isize { return authRes }
    if tableIdx >= db.tableCount || rowIdx >= db.tables[tableIdx].rowCount || colIdx >= db.tables[tableIdx].fieldCount {
        return -1 as isize
    }
    db.tables[tableIdx].cells[rowIdx * 16 as usize + colIdx] = val
    return 0 as isize
}
