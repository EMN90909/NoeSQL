module noqeri.database.noesql.secure_executor
import "noesql_executor.noqeri"
import "noesql_auth.noqeri"
import "noesql_limits.noqeri"

// Authorized entry point for the bounded NoeSQL executor. Keeping execution
// state behind a single request pointer makes this path compatible with the
// current x86-64 AOT backend while preventing argument-order ABI drift.
record NoeAuthorizedExecutionRequest {
    principal: *NoePrincipal
    scope: u64
    budget: *NoeBudget
    execution: *NoeExecutionRequest
}

export function noeExecuteAuthorized(req: *NoeAuthorizedExecutionRequest): isize {
    if req == null || req.execution == null || req.execution.plan == null || req.budget == null {
        return -30 as isize
    }
    let execution: *NoeExecutionRequest = req.execution
    if !noeOperationPermit(req.principal, execution.plan.operation, req.scope) { return -31 as isize }
    if len(execution.columns) == 0 as usize || execution.rowCount > len(execution.original) / len(execution.columns) {
        return -32 as isize
    }
    if execution.rowCount > 16777216 as usize { return -34 as isize }
    // Conservative quota: scan up to all input rows (including inserts).
    if !noeBudgetConsume(req.budget, execution.rowCount as u64 + 1 as u64, execution.rowCount + 1 as usize) {
        return -33 as isize
    }
    return noeExecute(execution)
}
