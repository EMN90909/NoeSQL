module noqeri.database.noesql.wal_engine

import "noesql_engine.noqeri"
import "noesql_wal.noqeri"
import "noesql_btree.noqeri"
import "../../Noqeri/Lib/std/file.noqeri"
import "../../Noqeri/Lib/std/fs.noqeri"
import "../../Noqeri/Lib/std/thread.noqeri"

// NoeSQL High-Performance Client-Server WAL Storage Engine
// Multi-Process Daemon Architecture with Sequential WAL Framing,
// Power-Loss Durability, Genuine Multi-Transaction Replay, Single-Writer
// Concurrency Protocol, Cross-Process Refresh, Full Rollback Reversion,
// Unbounded Multi-Statement Transactions, Durable TxID Persistence,
// and Torn-Tail Physical Repair.

record NoeWalTx {
    txId: u64
    sequence: u32
    inProgress: bool
    imageDigest: [u8; 32]
}

record NoeWalEngine {
    db: NoeDatabaseState
    dbPath: string
    walFd: usize
    lockFd: usize
    walOpen: bool
    lastTxId: u64
    walSequence: u32
    walBytesWritten: usize
    checkpointThreshold: usize
    primaryIndex: NoeBTree
    walCommittedOffset: usize
    baseGeneration: u64
    lastMaintenanceStatus: isize
}

function noeWalEncodeString(s: string, out: []u8): usize {
    return stringToBytes(s, &out[0], len(out))
}

export function noeWalEngineInit(engine: *NoeWalEngine): void {
    if engine == null { return }
    engine.walFd = 0 as usize
    engine.lockFd = 0 as usize
    engine.walOpen = false
    engine.lastTxId = 0 as u64
    engine.walSequence = 0 as u32
    engine.walBytesWritten = 0 as usize
    engine.checkpointThreshold = 65536 as usize
    engine.walCommittedOffset = 0 as usize
    engine.baseGeneration = 0 as u64
    engine.lastMaintenanceStatus = 0 as isize
    noeBTreeInit(&engine.primaryIndex)
}

function noeWalRebuildIndex(engine: *NoeWalEngine): void {
    noeBTreeInit(&engine.primaryIndex)
    if engine.db.tableCount > 0 as usize {
        let t: *NoeTableData = &engine.db.tables[0]
        let r: usize = 0 as usize
        while r < t.rowCount {
            let cell: *NoeRowCell = &t.cells[r * 16 as usize + 0 as usize]
            if !cell.isNull {
                noeBTreeInsert(&engine.primaryIndex, cell.intVal, r)
            }
            r = r + 1 as usize
        }
    }
}


function noeWalGetParentDir(path: string): string {
    let buf: [u8; 1024]
    let pLen: usize = stringToBytes(path, &buf[0], 1024 as usize)
    let lastSlash: isize = -1 as isize
    let i: usize = 0 as usize
    while i < pLen {
        if buf[i] == 47 as u8 { // '/'
            lastSlash = i as isize
        }
        i = i + 1 as usize
    }
    if lastSlash <= 0 as isize {
        return "."
    }
    return bytesToString(&buf[0], lastSlash as usize)
}

function noeWalSyncDirectory(path: string): isize {
    let res: isize = fs_directory_sync(path)
    if res < 0 as isize { return res }
    let parentDir: string = noeWalGetParentDir(path)
    return fs_directory_sync(parentDir)
}

// Streaming WAL Replay: reads sequentially without memory limits or statement count caps.
// Two-pass transaction replay:
//   Pass 1: Stream and cryptographically verify all images up to COMMIT.
//   Pass 2: Seek back and replay all images into active memory only after commit verified.
export function noeWalEngineStreamReplayFrom(engine: *NoeWalEngine, walFd: usize, startOffset: usize): isize {
    let fSizeIs: isize = file_size(walFd)
    if fSizeIs < 0 as isize { return fSizeIs }
    if fSizeIs == 0 as isize { return 0 as isize }
    let fSize: usize = fSizeIs as usize
    if startOffset >= fSize { return 0 as isize }

    let currOffset: usize = startOffset
    while currOffset < fSize {
        if file_seek(walFd, currOffset as i64, file_seek_start()) < 0 as isize {
            return -101 as isize
        }

        if currOffset + 56 as usize > fSize {
            // Incomplete header tail at EOF -> stop cleanly
            break
        }

        let hdr: [u8; 56]
        let rHdr: isize = file_read_exact(walFd, slice(hdr))
        if rHdr < 0 as isize {
            return -102 as isize // I/O read failure or short read -> fail closed!
        }

        if hdr[0] != 78 as u8 || hdr[1] != 87 as u8 || hdr[2] != 65 as u8 || hdr[3] != 76 as u8 {
            return -102 as isize // Corrupt header
        }

        let kind: int = hdr[6] as int
        let txId: u64 = noeWalGetNumber(slice(hdr), 8 as usize, 8 as usize)
        let seq: u32 = noeWalGetNumber(slice(hdr), 16 as usize, 4 as usize) as u32
        let pSize: usize = noeWalGetNumber(slice(hdr), 20 as usize, 4 as usize) as usize

        if kind != noeWalBegin() {
            // Not a BEGIN frame; advance past it
            currOffset = currOffset + 56 as usize + pSize
            continue
        }

        let firstImgOffset: usize = currOffset + 56 as usize + pSize
        let scanOff: usize = firstImgOffset

        // Pass 1: Cryptographic authentication of rolling digest across ALL images up to COMMIT
        let rollDigest: [u8; 32]
        let di: usize = 0 as usize
        while di < 32 as usize { rollDigest[di] = 0 as u8 di = di + 1 as usize }

        let imageCount: usize = 0 as usize
        let txCommitted: bool = false
        let nextTxOffset: usize = scanOff

        while scanOff < fSize {
            if file_seek(walFd, scanOff as i64, file_seek_start()) < 0 as isize { return -101 as isize }

            if scanOff + 56 as usize > fSize { break } // incomplete frame tail at EOF

            let nextHdr: [u8; 56]
            let rNextHdr: isize = file_read_exact(walFd, slice(nextHdr))
            if rNextHdr < 0 as isize { return -103 as isize } // I/O read failure or short read -> fail closed!

            if nextHdr[0] != 78 as u8 || nextHdr[1] != 87 as u8 || nextHdr[2] != 65 as u8 || nextHdr[3] != 76 as u8 {
                return -103 as isize // Corrupt frame
            }

            let nextKind: int = nextHdr[6] as int
            let nextTx: u64 = noeWalGetNumber(slice(nextHdr), 8 as usize, 8 as usize)
            let nextSeq: u32 = noeWalGetNumber(slice(nextHdr), 16 as usize, 4 as usize) as u32
            let nextPSize: usize = noeWalGetNumber(slice(nextHdr), 20 as usize, 4 as usize) as usize

            if nextKind == noeWalBegin() {
                // Prior transaction aborted before COMMIT
                nextTxOffset = scanOff
                break
            }

            if nextKind == noeWalImage() {
                if nextTx != txId { return -104 as isize }
                let payloadBuf: [u8; 2048]
                if nextPSize > 2048 as usize { return -105 as isize }
                if nextPSize > 0 as usize {
                    if scanOff + 56 as usize + nextPSize > fSize { break } // incomplete payload tail at EOF
                    let rPay: isize = file_read_exact(walFd, slice(&payloadBuf[0], nextPSize))
                    if rPay < 0 as isize { return -105 as isize } // I/O read failure or short read -> fail closed!
                    noeWalChainHash(&rollDigest[0], &payloadBuf[0], nextPSize, &rollDigest[0])
                }
                imageCount = imageCount + 1 as usize
                scanOff = scanOff + 56 as usize + nextPSize
                continue
            }

            if nextKind == noeWalCommit() {
                if nextTx != txId || nextPSize != 32 as usize { return -106 as isize }
                if scanOff + 56 as usize + 32 as usize > fSize { break } // incomplete commit tail at EOF
                let commitPayload: [u8; 32]
                let rC: isize = file_read_exact(walFd, slice(commitPayload))
                if rC < 0 as isize { return -106 as isize } // I/O read failure or short read -> fail closed!

                // Check chained rolling digest
                let matchFail: bool = false
                let ci: usize = 0 as usize
                while ci < 32 as usize {
                    if rollDigest[ci] != commitPayload[ci] { matchFail = true }
                    ci = ci + 1 as usize
                }
                if matchFail { return -107 as isize }

                txCommitted = true
                nextTxOffset = scanOff + 56 as usize + 32 as usize
                break
            }

            scanOff = scanOff + 56 as usize + nextPSize
        }

        if txCommitted {
            // Checkpoint Watermark Protection:
            // If txId <= engine.db.lastTxId, this transaction was already persisted into the base snapshot.
            // Replaying it would duplicate writes if a crash occurred after snapshot publication but before WAL truncation.
            if txId > engine.db.lastTxId {
                // Pass 2: Replay all statements in this transaction in sequence (NO ARRAY LIMIT!)
                if file_seek(walFd, firstImgOffset as i64, file_seek_start()) < 0 as isize {
                    return -108 as isize
                }
                let k: usize = 0 as usize
                while k < imageCount {
                    let imgHdr: [u8; 56]
                    let rIHdr: isize = file_read_exact(walFd, slice(imgHdr))
                    if rIHdr < 0 as isize { return -109 as isize }
                    let imgLen: usize = noeWalGetNumber(slice(imgHdr), 20 as usize, 4 as usize) as usize
                    if imgLen > 0 as usize && imgLen <= 2048 as usize {
                        let stmtBuf: [u8; 2048]
                        let rStmt: isize = file_read_exact(walFd, slice(&stmtBuf[0], imgLen))
                        if rStmt < 0 as isize { return -110 as isize }
                        let stmt: string = bytesToString(&stmtBuf[0], imgLen)
                        noeExecuteStatement(&engine.db, stmt)
                        if engine.db.tableCount > 0 as usize {
                            let t: *NoeTableData = &engine.db.tables[0]
                            if t.rowCount > 0 as usize {
                                let lastRow: usize = t.rowCount - 1 as usize
                                let cell: *NoeRowCell = &t.cells[lastRow * 16 as usize + 0 as usize]
                                if !cell.isNull {
                                    noeBTreeInsert(&engine.primaryIndex, cell.intVal, lastRow)
                                }
                            }
                        }
                    }
                    k = k + 1 as usize
                }
            }

            if txId > engine.lastTxId {
                engine.lastTxId = txId
            }
            engine.walCommittedOffset = nextTxOffset
            currOffset = nextTxOffset
        } else {
            // Uncommitted transaction or torn tail
            if nextTxOffset > currOffset {
                currOffset = nextTxOffset
            } else {
                break
            }
        }
    }

    return 0 as isize
}

// Cross-process state refresh: guarantees in-memory database and lastTxId are
// up-to-date with any checkpoints or writes committed by other processes.
export function noeWalEngineRefresh(engine: *NoeWalEngine): isize {
    if engine == null { return -1 as isize }

    // 1. Check if HEAD points to a newer generation (checkpoint in another process)
    let currentGen: u64 = noeReadActiveGeneration(engine.dbPath)
    if currentGen > engine.baseGeneration {
        let openStatus: isize = noeDbOpenV3(&engine.db, engine.dbPath)
        if openStatus != 0 as isize { return openStatus }
        engine.baseGeneration = currentGen
        engine.walCommittedOffset = 0 as usize
        if engine.db.lastTxId > engine.lastTxId {
            engine.lastTxId = engine.db.lastTxId
        }
        noeWalRebuildIndex(engine)
    }

    let walPath: string = engine.dbPath + "/WAL.log"
    if !fs_exists(walPath) {
        if engine.walFd != 0 as usize {
            file_close(engine.walFd)
            engine.walFd = 0 as usize
        }
        engine.walOpen = false
        return -17 as isize // Missing WAL.log / unlinked WAL
    }

    // Inspect actual disk file size to prevent bypass via unlinked/replaced open descriptor
    let diskWalHandle: isize = file_open_read(walPath)
    if !file_handle_valid(diskWalHandle) {
        if engine.walFd != 0 as usize {
            file_close(engine.walFd)
            engine.walFd = 0 as usize
        }
        engine.walOpen = false
        return -17 as isize
    }
    let diskSizeIs: isize = file_size(diskWalHandle as usize)
    file_close(diskWalHandle as usize)
    if diskSizeIs < 0 as isize {
        if engine.walFd != 0 as usize {
            file_close(engine.walFd)
            engine.walFd = 0 as usize
        }
        engine.walOpen = false
        return -17 as isize
    }

    let diskSize: usize = diskSizeIs as usize
    let diskInode: i64 = fs_inode(walPath)
    let diskDev: i64 = fs_dev(walPath)
    if diskInode <= 0 as i64 || diskDev <= 0 as i64 {
        if engine.walFd != 0 as usize {
            file_close(engine.walFd)
            engine.walFd = 0 as usize
        }
        engine.walOpen = false
        return -17 as isize // Failed identity lookup fails closed!
    }

    let identityReplaced: bool = false

    // 2. Fast-path: if disk WAL size matches our verified committed offset
    // AND our open walFd size matches diskSize, AND device & inode identity match,
    // then no external writes or file replacements occurred.
    if engine.walFd != 0 as usize {
        let curInode: i64 = file_inode(engine.walFd)
        let curDev: i64 = file_dev(engine.walFd)
        let curSizeIs: isize = file_size(engine.walFd)
        if curInode <= 0 as i64 || curDev <= 0 as i64 {
            file_close(engine.walFd)
            engine.walFd = 0 as usize
            engine.walOpen = false
            return -17 as isize // Descriptor identity failure fails closed!
        }
        if curDev == diskDev && curInode == diskInode && curSizeIs >= 0 as isize && (curSizeIs as usize) == engine.walCommittedOffset && diskSize == engine.walCommittedOffset {
            engine.walBytesWritten = engine.walCommittedOffset
            return 0 as isize // Fast-path: verified device, inode and size match!
        }
        if curDev != diskDev || curInode != diskInode || curSizeIs < 0 as isize || (curSizeIs as usize) != diskSize {
            if curDev != diskDev || curInode != diskInode {
                identityReplaced = true
            }
            // Re-bind walFd if file was replaced (same size or different) or truncated
            file_close(engine.walFd)
            let appHandle: isize = file_open_append(walPath)
            if !file_handle_valid(appHandle) {
                engine.walFd = 0 as usize
                engine.walOpen = false
                return -14 as isize
            }
            engine.walFd = appHandle as usize
        }
    }

    if identityReplaced || diskSize < engine.walCommittedOffset {
        // WAL was replaced or truncated externally:
        // NEVER replay from offset zero into already-mutated in-memory database!
        // First restore in-memory database cleanly from the verified base snapshot on disk under lock.
        let reloadStatus: isize = noeDbOpenV3(&engine.db, engine.dbPath)
        if reloadStatus != 0 as isize {
            if engine.walFd != 0 as usize { file_close(engine.walFd); engine.walFd = 0 as usize }
            engine.walOpen = false
            return reloadStatus
        }
        engine.baseGeneration = currentGen
        engine.walCommittedOffset = 0 as usize
        engine.lastTxId = engine.db.lastTxId
        noeWalRebuildIndex(engine)
    }

    if diskSize > 0 as usize {
        if diskSize > engine.walCommittedOffset {
            let walReadHandle: isize = file_open_read(walPath)
            if !file_handle_valid(walReadHandle) { return -14 as isize }
            let repRes: isize = noeWalEngineStreamReplayFrom(engine, walReadHandle as usize, engine.walCommittedOffset)
            file_close(walReadHandle as usize)
            if repRes < 0 as isize {
                if engine.walFd != 0 as usize { file_close(engine.walFd); engine.walFd = 0 as usize }
                engine.walOpen = false
                return repRes // Continuity / format broken: reject unexpected WAL replacement!
            }
        }
    } else {
        engine.walCommittedOffset = 0 as usize
    }

    // Always synchronize walBytesWritten with verified committed offset
    engine.walBytesWritten = engine.walCommittedOffset
    return 0 as isize
}

// Reverts in-memory database and B-tree to the exact last committed state
export function noeWalEngineRevert(engine: *NoeWalEngine): isize {
    if engine == null { return -1 as isize }

    // 1. Reload base database snapshot
    let openStatus: isize = noeDbOpenV3(&engine.db, engine.dbPath)
    if openStatus != 0 as isize { return openStatus }
    engine.baseGeneration = engine.db.generation
    noeWalRebuildIndex(engine)

    // 2. Replay verified committed transactions from WAL log
    if engine.walCommittedOffset > 0 as usize {
        let walPath: string = engine.dbPath + "/WAL.log"
        if !fs_exists(walPath) {
            return -17 as isize // Missing WAL.log during revert of committed transactions!
        }
        let walReadHandle: isize = file_open_read(walPath)
        if !file_handle_valid(walReadHandle) {
            return -14 as isize
        }
        let targetOffset: usize = engine.walCommittedOffset
        engine.walCommittedOffset = 0 as usize
        let repRes: isize = noeWalEngineStreamReplayFrom(engine, walReadHandle as usize, 0 as usize)
        file_close(walReadHandle as usize)
        if repRes < 0 as isize { return repRes }
    }

    return 0 as isize
}

// ----------------------------------------------------------------------------
// Durable Transaction Outcome Ledger & Authenticated Reconciliation
// ----------------------------------------------------------------------------

// Durable Transaction Outcome Ledger (survives checkpointing and WAL truncation)
// Header: 32 bytes: "NQTL0002" (8 bytes) + 24 bytes reserved zeros
// Entries: 32 bytes: txId (u64, 8 bytes) + status (u32, 4 bytes) + flags (u32, 4 bytes) + sha256 (16 bytes)
// status: 1 = COMMITTED, 2 = ABORTED

export function noeWalLedgerEnsureV2(dbPath: string): isize {
    if dbPath == "" { return -1 as isize }
    let ledgerPath: string = dbPath + "/tx_outcomes.log"
    if !fs_exists(ledgerPath) {
        return 0 as isize // No ledger file to migrate
    }

    let h: isize = file_open_read(ledgerPath)
    if !file_handle_valid(h) { return -1 as isize }

    let fSizeIs: isize = file_size(h as usize)
    if fSizeIs < 16 as isize {
        file_close(h as usize)
        return 0 as isize // Not a legacy NQTL0001 ledger, nothing to migrate
    }

    // Read first 16 bytes to check format version
    let hdr: [u8; 16]
    let rH: isize = file_read_exact(h as usize, slice(hdr))
    if rH < 0 as isize {
        file_close(h as usize)
        return -1 as isize
    }

    // Verify magic "NQTL000"
    if hdr[0] != 78 as u8 || hdr[1] != 81 as u8 || hdr[2] != 84 as u8 || hdr[3] != 76 as u8 ||
       hdr[4] != 48 as u8 || hdr[5] != 48 as u8 || hdr[6] != 48 as u8 {
        file_close(h as usize)
        return 0 as isize // Not a valid NQTL header, nothing to migrate
    }

    // If already NQTL0002, nothing to migrate!
    if hdr[7] == 50 as u8 { // '2'
        file_close(h as usize)
        return 0 as isize
    }

    // If not NQTL0001, unknown version
    if hdr[7] != 49 as u8 { // '1'
        file_close(h as usize)
        return 0 as isize
    }

    // It is NQTL0001: perform atomic migration to NQTL0002
    let dataBytes: usize = fSizeIs as usize - 16 as usize
    if dataBytes % 16 as usize != 0 as usize {
        file_close(h as usize)
        return -1 as isize // Corrupt NQTL0001 record boundaries
    }

    let totalEntries: usize = dataBytes / 16 as usize
    let tmpPath: string = dbPath + "/tx_outcomes.log.migrating"
    let th: isize = file_open_create(tmpPath)
    if !file_handle_valid(th) {
        file_close(h as usize)
        return -1 as isize
    }

    // Write 32-byte NQTL0002 header to tmpPath
    let hdr2: [u8; 32]
    hdr2[0] = 78 as u8 hdr2[1] = 81 as u8 hdr2[2] = 84 as u8 hdr2[3] = 76 as u8
    hdr2[4] = 48 as u8 hdr2[5] = 48 as u8 hdr2[6] = 48 as u8 hdr2[7] = 50 as u8
    let hi: usize = 8 as usize
    while hi < 32 as usize { hdr2[hi] = 0 as u8 hi = hi + 1 as usize }
    let wH: isize = file_write_all(th as usize, slice(hdr2))
    if wH < 0 as isize {
        file_close(h as usize)
        file_close(th as usize)
        fs_remove(tmpPath)
        return -1 as isize
    }

    // Read each 16-byte NQTL0001 entry, convert to 32-byte checksummed NQTL0002 entry, and write
    let entryIdx: usize = 0 as usize
    while entryIdx < totalEntries {
        let e1: [u8; 16]
        let rE: isize = file_read_exact(h as usize, slice(e1))
        if rE < 0 as isize {
            file_close(h as usize)
            file_close(th as usize)
            fs_remove(tmpPath)
            return -1 as isize
        }

        let eTx: u64 = noeWalGetNumber(slice(e1), 0 as usize, 8 as usize)
        let eStatus: u32 = noeWalGetNumber(slice(e1), 8 as usize, 4 as usize) as u32

        let e2: [u8; 32]
        noeWalPutNumber(slice(e2), 0 as usize, 8 as usize, eTx)
        noeWalPutNumber(slice(e2), 8 as usize, 4 as usize, eStatus as u64)
        noeWalPutNumber(slice(e2), 12 as usize, 4 as usize, 0 as u64)

        let shaBuf: [u8; 32]
        if noeWalComputeSha256(&e2[0], 16 as usize, &shaBuf[0], 32 as usize) != 0 as isize {
            file_close(h as usize)
            file_close(th as usize)
            fs_remove(tmpPath)
            return -1 as isize
        }
        let ci: usize = 0 as usize
        while ci < 16 as usize {
            e2[16 as usize + ci] = shaBuf[ci]
            ci = ci + 1 as usize
        }

        let wE: isize = file_write_all(th as usize, slice(e2))
        if wE < 0 as isize {
            file_close(h as usize)
            file_close(th as usize)
            fs_remove(tmpPath)
            return -1 as isize
        }
        entryIdx = entryIdx + 1 as usize
    }

    file_close(h as usize)

    // Fsync the migrated file before publishing
    let sRes: isize = file_sync(th as usize)
    file_close(th as usize)
    if sRes < 0 as isize {
        fs_remove(tmpPath)
        return sRes
    }

    // Atomic replacement: rename tmpPath -> ledgerPath
    let renRes: isize = fs_rename(tmpPath, ledgerPath)
    if renRes < 0 as isize {
        fs_remove(tmpPath)
        return renRes
    }

    // Fsync directory to ensure atomic rename is durable on disk
    let dirRes: isize = noeWalSyncDirectory(dbPath)
    if dirRes < 0 as isize {
        return dirRes
    }

    return 0 as isize
}

export function noeWalLedgerRecordOutcome(dbPath: string, txId: u64, status: u32, doSync: bool): isize {
    if txId == 0 as u64 { return 0 as isize }
    if fs_exists(dbPath + "/.noesql_testing_faults_enabled") && fs_exists(dbPath + "/FAULT_LEDGER_WRITE_FAIL.flag") {
        return -27 as isize
    }
    // Ensure legacy NQTL0001 ledger is migrated before any append
    let migRes: isize = noeWalLedgerEnsureV2(dbPath)
    if migRes < 0 as isize { return migRes }

    let ledgerPath: string = dbPath + "/tx_outcomes.log"
    let exists: bool = fs_exists(ledgerPath)
    let h: isize = -1 as isize

    if !exists {
        h = file_open_create(ledgerPath)
        if !file_handle_valid(h) { return -1 as isize }
        // Write 32-byte header: "NQTL0002" + 24 reserved zero bytes
        let hdr: [u8; 32]
        hdr[0] = 78 as u8 hdr[1] = 81 as u8 hdr[2] = 84 as u8 hdr[3] = 76 as u8
        hdr[4] = 48 as u8 hdr[5] = 48 as u8 hdr[6] = 48 as u8 hdr[7] = 50 as u8
        let hi: usize = 8 as usize
        while hi < 32 as usize { hdr[hi] = 0 as u8 hi = hi + 1 as usize }
        let wH: isize = file_write_all(h as usize, slice(hdr))
        if wH < 0 as isize { file_close(h as usize) return -1 as isize }
    } else {
        h = file_open_append(ledgerPath)
        if !file_handle_valid(h) { return -1 as isize }
    }

    // Write 32-byte entry: [txId: 8, status: 4, flags: 4, sha256: 16]
    let entry: [u8; 32]
    noeWalPutNumber(slice(entry), 0 as usize, 8 as usize, txId)
    noeWalPutNumber(slice(entry), 8 as usize, 4 as usize, status as u64)
    noeWalPutNumber(slice(entry), 12 as usize, 4 as usize, 0 as u64)
    let shaBuf: [u8; 32]
    if noeWalComputeSha256(&entry[0], 16 as usize, &shaBuf[0], 32 as usize) != 0 as isize {
        file_close(h as usize)
        return -1 as isize
    }
    let ci: usize = 0 as usize
    while ci < 16 as usize {
        entry[16 as usize + ci] = shaBuf[ci]
        ci = ci + 1 as usize
    }

    let wE: isize = file_write_all(h as usize, slice(entry))
    if wE < 0 as isize { file_close(h as usize) return -1 as isize }

    if doSync {
        if fs_exists(dbPath + "/.noesql_testing_faults_enabled") && fs_exists(dbPath + "/FAULT_LEDGER_SYNC_FAIL.flag") {
            file_close(h as usize)
            return -29 as isize
        }
        let sRes: isize = file_sync(h as usize)
        file_close(h as usize)
        if sRes < 0 as isize { return sRes }
        noeWalSyncDirectory(dbPath)
        return 0 as isize
    }
    file_close(h as usize)
    return 0 as isize
}

export function noeWalLedgerQueryOutcome(dbPath: string, targetTxId: u64): int {
    if targetTxId == 0 as u64 { return 0 }
    let ledgerPath: string = dbPath + "/tx_outcomes.log"
    if !fs_exists(ledgerPath) {
        return 0 // Not in ledger
    }

    // Ensure legacy NQTL0001 ledger is upgraded to V2 if present
    noeWalLedgerEnsureV2(dbPath)

    let h: isize = file_open_read(ledgerPath)
    if !file_handle_valid(h) { return -1 } // cannot read ledger -> unknown

    let fSizeIs: isize = file_size(h as usize)
    if fSizeIs < 16 as isize {
        file_close(h as usize)
        return -1 // truncated or empty ledger (< header size) -> unknown
    }

    // Read header (up to 32 bytes)
    let hdr: [u8; 32]
    let toReadHdr: usize = 32 as usize
    if (fSizeIs as usize) < 32 as usize {
        toReadHdr = 16 as usize
    }
    let rH: isize = file_read_exact(h as usize, slice(&hdr[0], toReadHdr))
    if rH < 0 as isize {
        file_close(h as usize)
        return -1
    }

    // Check magic: "NQTL0001" (legacy 16-byte) or "NQTL0002" (checksummed 32-byte)
    if hdr[0] != 78 as u8 || hdr[1] != 81 as u8 || hdr[2] != 84 as u8 || hdr[3] != 76 as u8 ||
       hdr[4] != 48 as u8 || hdr[5] != 48 as u8 || hdr[6] != 48 as u8 {
        file_close(h as usize)
        return -1 // Corrupt ledger magic
    }

    let entrySize: usize = 32 as usize
    let hdrSize: usize = 32 as usize
    let isChecksummed: bool = true

    if hdr[7] == 49 as u8 { // "NQTL0001"
        entrySize = 16 as usize
        hdrSize = 16 as usize
        isChecksummed = false
        file_seek(h as usize, 16 as i64, 0)
    } else if hdr[7] == 50 as u8 { // "NQTL0002"
        entrySize = 32 as usize
        hdrSize = 32 as usize
        isChecksummed = true
        if fSizeIs < 32 as isize {
            file_close(h as usize)
            return -1 // Incomplete NQTL0002 header
        }
    } else {
        file_close(h as usize)
        return -1 // Unsupported version
    }

    // Validate complete record boundaries: fail closed on incomplete trailing bytes!
    let dataBytes: usize = fSizeIs as usize - hdrSize
    if dataBytes % entrySize != 0 as usize {
        file_close(h as usize)
        return -1 // Damaged/torn record boundary
    }

    let totalEntries: usize = dataBytes / entrySize
    let entryIdx: usize = 0 as usize
    let latestStatus: int = 0 // 0 = not found, 1 = committed, 2 = aborted

    while entryIdx < totalEntries {
        let entry: [u8; 32]
        let rE: isize = file_read_exact(h as usize, slice(&entry[0], entrySize))
        if rE < 0 as isize {
            file_close(h as usize)
            return -1
        }

        if isChecksummed {
            let shaBuf: [u8; 32]
            if noeWalComputeSha256(&entry[0], 16 as usize, &shaBuf[0], 32 as usize) != 0 as isize {
                file_close(h as usize)
                return -1
            }
            let ci: usize = 0 as usize
            let matchFail: bool = false
            while ci < 16 as usize {
                if entry[16 as usize + ci] != shaBuf[ci] { matchFail = true }
                ci = ci + 1 as usize
            }
            if matchFail {
                file_close(h as usize)
                return -1 // Checksum mismatch on ledger entry!
            }
        }

        let eTx: u64 = noeWalGetNumber(slice(entry), 0 as usize, 8 as usize)
        let eStatus: u32 = noeWalGetNumber(slice(entry), 8 as usize, 4 as usize) as u32
        if eTx == targetTxId {
            if eStatus == 1 as u32 {
                latestStatus = 1 // Confirmed committed
            } else if eStatus == 2 as u32 {
                latestStatus = 2 // Explicitly recorded aborted / rolled back
            }
        }
        entryIdx = entryIdx + 1 as usize
    }

    file_close(h as usize)

    if latestStatus == 1 { return 1 }
    if latestStatus == 2 { return 2 }
    return 0 // Not in ledger
}

export function noeWalScanAuthenticatedCommit(engine: *NoeWalEngine, targetTxId: u64): int {
    if engine == null || targetTxId == 0 as u64 { return -1 }
    let walPath: string = engine.dbPath + "/WAL.log"
    if !fs_exists(walPath) { return 0 }

    let walFd: isize = file_open_read(walPath)
    if !file_handle_valid(walFd) { return -1 }

    let fSizeIs: isize = file_size(walFd as usize)
    if fSizeIs < 0 as isize {
        file_close(walFd as usize)
        return -1
    }

    let fSize: usize = fSizeIs as usize
    let limitOffset: usize = engine.walCommittedOffset
    if limitOffset > fSize { limitOffset = fSize }
    if limitOffset == 0 as usize {
        file_close(walFd as usize)
        return 0
    }

    let currOffset: usize = 0 as usize

    while currOffset + 56 as usize <= limitOffset {
        if file_seek(walFd as usize, currOffset as i64, 0) < 0 as isize {
            file_close(walFd as usize)
            return -1
        }
        let hdr: [u8; 56]
        let rH: isize = file_read_exact(walFd as usize, slice(hdr))
        if rH < 0 as isize {
            file_close(walFd as usize)
            return -1
        }

        if hdr[0] != 78 as u8 || hdr[1] != 87 as u8 || hdr[2] != 65 as u8 || hdr[3] != 76 as u8 {
            file_close(walFd as usize)
            return -1 // Corrupt frame within committed WAL
        }

        let kind: int = hdr[6] as int
        let frameTx: u64 = noeWalGetNumber(slice(hdr), 8 as usize, 8 as usize)
        let pSize: usize = noeWalGetNumber(slice(hdr), 20 as usize, 4 as usize) as usize

        if currOffset + 56 as usize + pSize > limitOffset {
            file_close(walFd as usize)
            return -1 // Payload overruns committed WAL
        }

        if kind == noeWalBegin() {
            let txId: u64 = frameTx
            let rollDigest: [u8; 32]
            let di: usize = 0 as usize
            while di < 32 as usize { rollDigest[di] = 0 as u8 di = di + 1 as usize }

            let scanOff: usize = currOffset + 56 as usize + pSize
            let txCommitted: bool = false
            let nextBeginOffset: usize = scanOff

            while scanOff + 56 as usize <= limitOffset {
                if file_seek(walFd as usize, scanOff as i64, 0) < 0 as isize {
                    file_close(walFd as usize)
                    return -1
                }
                let nextHdr: [u8; 56]
                let rNext: isize = file_read_exact(walFd as usize, slice(nextHdr))
                if rNext < 0 as isize {
                    file_close(walFd as usize)
                    return -1
                }

                if nextHdr[0] != 78 as u8 || nextHdr[1] != 87 as u8 || nextHdr[2] != 65 as u8 || nextHdr[3] != 76 as u8 {
                    file_close(walFd as usize)
                    return -1 // Corrupt frame
                }

                let nextKind: int = nextHdr[6] as int
                let nextTx: u64 = noeWalGetNumber(slice(nextHdr), 8 as usize, 8 as usize)
                let nextPSize: usize = noeWalGetNumber(slice(nextHdr), 20 as usize, 4 as usize) as usize

                if scanOff + 56 as usize + nextPSize > limitOffset {
                    file_close(walFd as usize)
                    return -1 // Payload overruns committed WAL
                }

                if nextKind == noeWalBegin() {
                    // Previous transaction ended without commit
                    nextBeginOffset = scanOff
                    break
                }

                if nextKind == noeWalImage() {
                    if nextTx == txId && nextPSize <= 2048 as usize {
                        let payBuf: [u8; 2048]
                        let rPay: isize = file_read_exact(walFd as usize, slice(&payBuf[0], nextPSize))
                        if rPay < 0 as isize {
                            file_close(walFd as usize)
                            return -1
                        }
                        noeWalChainHash(&rollDigest[0], &payBuf[0], nextPSize, &rollDigest[0])
                    }
                    scanOff = scanOff + 56 as usize + nextPSize
                    nextBeginOffset = scanOff
                    continue
                }

                if nextKind == noeWalCommit() {
                    if nextTx == txId && nextPSize == 32 as usize {
                        let commitPayload: [u8; 32]
                        let rC: isize = file_read_exact(walFd as usize, slice(commitPayload))
                        if rC < 0 as isize {
                            file_close(walFd as usize)
                            return -1
                        }

                        // Authenticate: verify rolling digest matches commit frame
                        let matchFail: bool = false
                        let ci: usize = 0 as usize
                        while ci < 32 as usize {
                            if rollDigest[ci] != commitPayload[ci] { matchFail = true }
                            ci = ci + 1 as usize
                        }
                        if !matchFail {
                            txCommitted = true
                        }
                    }
                    scanOff = scanOff + 56 as usize + nextPSize
                    nextBeginOffset = scanOff
                    break
                }

                scanOff = scanOff + 56 as usize + nextPSize
                nextBeginOffset = scanOff
            }

            if txCommitted && txId == targetTxId {
                file_close(walFd as usize)
                return 1 // Cryptographically authenticated commit!
            }

            currOffset = nextBeginOffset
            continue
        }

        currOffset = currOffset + 56 as usize + pSize
    }

    if currOffset != limitOffset {
        file_close(walFd as usize)
        return -1 // Incomplete scan within committed WAL
    }

    file_close(walFd as usize)
    return 0 // Not found as an authenticated commit in active WAL
}

export function noeWalLedgerConsolidateWal(engine: *NoeWalEngine): isize {
    if engine == null || engine.dbPath == "" { return -1 as isize }

    if fs_exists(engine.dbPath + "/.noesql_testing_faults_enabled") && fs_exists(engine.dbPath + "/FAULT_LEDGER_WRITE_FAIL.flag") {
        return -27 as isize // Injected ledger write failure
    }

    let migRes: isize = noeWalLedgerEnsureV2(engine.dbPath)
    if migRes < 0 as isize { return migRes }

    let walPath: string = engine.dbPath + "/WAL.log"
    if fs_exists(walPath) {
        if fs_exists(engine.dbPath + "/.noesql_testing_faults_enabled") && fs_exists(engine.dbPath + "/FAULT_CONSOLIDATE_WAL_READ_FAIL.flag") {
            return -35 as isize // Injected WAL read failure during consolidation
        }

        let walFd: isize = file_open_read(walPath)
        if !file_handle_valid(walFd) { return -14 as isize }

        let fSizeIs: isize = file_size(walFd as usize)
        if fSizeIs < 0 as isize {
            file_close(walFd as usize)
            return fSizeIs
        }

        let fSize: usize = fSizeIs as usize
        let limitOffset: usize = engine.walCommittedOffset
        if limitOffset > fSize { limitOffset = fSize }

        let currOffset: usize = 0 as usize
        while currOffset + 56 as usize <= limitOffset {
            if file_seek(walFd as usize, currOffset as i64, 0) < 0 as isize {
                file_close(walFd as usize)
                return -31 as isize
            }
            let hdr: [u8; 56]
            let rH: isize = file_read_exact(walFd as usize, slice(hdr))
            if rH < 0 as isize {
                file_close(walFd as usize)
                return -31 as isize
            }

            if hdr[0] != 78 as u8 || hdr[1] != 87 as u8 || hdr[2] != 65 as u8 || hdr[3] != 76 as u8 {
                file_close(walFd as usize)
                return -32 as isize // Corrupt header magic within committed WAL!
            }

            let kind: int = hdr[6] as int
            let frameTx: u64 = noeWalGetNumber(slice(hdr), 8 as usize, 8 as usize)
            let pSize: usize = noeWalGetNumber(slice(hdr), 20 as usize, 4 as usize) as usize

            if currOffset + 56 as usize + pSize > limitOffset {
                file_close(walFd as usize)
                return -33 as isize // Frame payload overruns committed WAL!
            }

            if kind == noeWalBegin() {
                let txId: u64 = frameTx
                let rollDigest: [u8; 32]
                let di: usize = 0 as usize
                while di < 32 as usize { rollDigest[di] = 0 as u8 di = di + 1 as usize }

                let scanOff: usize = currOffset + 56 as usize + pSize
                let txCommitted: bool = false
                let nextBeginOffset: usize = scanOff

                while scanOff + 56 as usize <= limitOffset {
                    if file_seek(walFd as usize, scanOff as i64, 0) < 0 as isize {
                        file_close(walFd as usize)
                        return -31 as isize
                    }
                    let nextHdr: [u8; 56]
                    let rNext: isize = file_read_exact(walFd as usize, slice(nextHdr))
                    if rNext < 0 as isize {
                        file_close(walFd as usize)
                        return -31 as isize
                    }

                    if nextHdr[0] != 78 as u8 || nextHdr[1] != 87 as u8 || nextHdr[2] != 65 as u8 || nextHdr[3] != 76 as u8 {
                        file_close(walFd as usize)
                        return -32 as isize // Corrupt frame magic within committed WAL!
                    }

                    let nextKind: int = nextHdr[6] as int
                    let nextTx: u64 = noeWalGetNumber(slice(nextHdr), 8 as usize, 8 as usize)
                    let nextPSize: usize = noeWalGetNumber(slice(nextHdr), 20 as usize, 4 as usize) as usize

                    if scanOff + 56 as usize + nextPSize > limitOffset {
                        file_close(walFd as usize)
                        return -33 as isize // Frame payload overruns committed WAL!
                    }

                    if nextKind == noeWalBegin() {
                        nextBeginOffset = scanOff
                        break
                    }

                    if nextKind == noeWalImage() {
                        if nextTx == txId && nextPSize <= 2048 as usize {
                            let payBuf: [u8; 2048]
                            let rPay: isize = file_read_exact(walFd as usize, slice(&payBuf[0], nextPSize))
                            if rPay < 0 as isize {
                                file_close(walFd as usize)
                                return -31 as isize
                            }
                            noeWalChainHash(&rollDigest[0], &payBuf[0], nextPSize, &rollDigest[0])
                        }
                        scanOff = scanOff + 56 as usize + nextPSize
                        nextBeginOffset = scanOff
                        continue
                    }

                    if nextKind == noeWalCommit() {
                        if nextTx == txId && nextPSize == 32 as usize {
                            let commitPayload: [u8; 32]
                            let rC: isize = file_read_exact(walFd as usize, slice(commitPayload))
                            if rC < 0 as isize {
                                file_close(walFd as usize)
                                return -31 as isize
                            }

                            let matchFail: bool = false
                            let ci: usize = 0 as usize
                            while ci < 32 as usize {
                                if rollDigest[ci] != commitPayload[ci] { matchFail = true }
                                ci = ci + 1 as usize
                            }
                            if !matchFail {
                                txCommitted = true
                            }
                        }
                        scanOff = scanOff + 56 as usize + nextPSize
                        nextBeginOffset = scanOff
                        break
                    }

                    scanOff = scanOff + 56 as usize + nextPSize
                    nextBeginOffset = scanOff
                }

                if txCommitted {
                    let qRes: int = noeWalLedgerQueryOutcome(engine.dbPath, txId)
                    if qRes == -1 {
                        file_close(walFd as usize)
                        return -28 as isize // Ledger integrity failure during consolidation
                    }
                    if qRes != 1 {
                        let recRes: isize = noeWalLedgerRecordOutcome(engine.dbPath, txId, 1 as u32, false)
                        if recRes < 0 as isize {
                            file_close(walFd as usize)
                            return recRes
                        }
                    }
                }

                currOffset = nextBeginOffset
                continue
            }

            currOffset = currOffset + 56 as usize + pSize
        }

        if currOffset != limitOffset {
            file_close(walFd as usize)
            return -34 as isize // Incomplete scan: did not reach limitOffset cleanly!
        }

        file_close(walFd as usize)
    }

    if fs_exists(engine.dbPath + "/.noesql_testing_faults_enabled") && fs_exists(engine.dbPath + "/FAULT_LEDGER_SYNC_FAIL.flag") {
        return -29 as isize // Injected ledger sync failure
    }

    // Durability sync barrier: even if no new records were appended, ensure ledger file and directory are synced
    let ledgerPath: string = engine.dbPath + "/tx_outcomes.log"
    if fs_exists(ledgerPath) {
        let lh: isize = file_open_append(ledgerPath)
        if !file_handle_valid(lh) {
            return -30 as isize // Failed to open ledger for durability sync
        }
        let sRes: isize = file_sync(lh as usize)
        file_close(lh as usize)
        if sRes < 0 as isize {
            return sRes
        }
    }
    let dRes: isize = noeWalSyncDirectory(engine.dbPath)
    if dRes < 0 as isize {
        return dRes
    }

    return 0 as isize
}

export function noeWalEngineOpen(engine: *NoeWalEngine, path: string): isize {
    if engine == null || path == "" { return -1 as isize }
    noeWalEngineInit(engine)
    engine.dbPath = path

    // 1. Ensure directory exists
    fs_ensure_directory(path)
    noeWalSyncDirectory(path)

    // 2. Open cross-process lock descriptor and ACQUIRE LOCK BEFORE ANY SNAPSHOT OR WAL READS!
    let lockPath: string = path + "/WAL.lck"
    let lFd: isize = file_open_create(lockPath)
    if !file_handle_valid(lFd) {
        return -2 as isize
    }
    engine.lockFd = lFd as usize
    noeWalSyncDirectory(path)

    let lockRes: isize = file_lock(engine.lockFd, true)
    if lockRes < 0 as isize {
        file_close(engine.lockFd)
        return lockRes
    }

    // Ensure legacy NQTL0001 ledger is migrated to V2 under exclusive lock
    let migRes: isize = noeWalLedgerEnsureV2(path)
    if migRes < 0 as isize {
        file_unlock(engine.lockFd)
        file_close(engine.lockFd)
        return migRes
    }

    // 3. Under exclusive lock: load base database snapshot
    if fs_exists(path + "/HEAD") {
        let openStatus: isize = noeDbOpenV3(&engine.db, path)
        if openStatus != 0 as isize {
            file_unlock(engine.lockFd)
            file_close(engine.lockFd)
            return openStatus
        }
        engine.baseGeneration = engine.db.generation
        engine.lastTxId = engine.db.lastTxId
    } else {
        noeEngineInit(&engine.db, "main")
        let initSave: isize = noeDbSaveV3(&engine.db, path)
        if initSave != 0 as isize {
            file_unlock(engine.lockFd)
            file_close(engine.lockFd)
            return initSave
        }
        engine.baseGeneration = 1 as u64
        engine.lastTxId = 0 as u64
        noeWalSyncDirectory(path)
    }

    // 4. Under exclusive lock: replay WAL
    let walPath: string = path + "/WAL.log"
    let initialWalSize: usize = 0 as usize
    if fs_exists(walPath) {
        let walReadHandle: isize = file_open_read(walPath)
        if !file_handle_valid(walReadHandle) {
            file_unlock(engine.lockFd)
            file_close(engine.lockFd)
            return -14 as isize // Failed to open existing WAL.log for reading
        }
        let fSizeIs: isize = file_size(walReadHandle as usize)
        if fSizeIs < 0 as isize {
            file_close(walReadHandle as usize)
            file_unlock(engine.lockFd)
            file_close(engine.lockFd)
            return fSizeIs
        }
        if fSizeIs > 0 as isize {
            initialWalSize = fSizeIs as usize
        }
        let repRes: isize = noeWalEngineStreamReplayFrom(engine, walReadHandle as usize, 0 as usize)
        file_close(walReadHandle as usize)
        if repRes < 0 as isize {
            file_unlock(engine.lockFd)
            file_close(engine.lockFd)
            return repRes
        }
    }

    // Repair torn WAL tails before opening for appending!
    // If disk file is larger than verified committed offset, truncate garbage tail physically.
    if initialWalSize > engine.walCommittedOffset {
        let truncHandle: isize = file_open_write(walPath)
        if !file_handle_valid(truncHandle) {
            file_unlock(engine.lockFd)
            file_close(engine.lockFd)
            return -10 as isize // Failed to open WAL for physical repair
        }
        if fs_exists(path + "/.noesql_testing_faults_enabled") && fs_exists(path + "/FAULT_TRUNCATE_FAIL.flag") {
            file_close(truncHandle as usize)
            file_unlock(engine.lockFd)
            file_close(engine.lockFd)
            return -11 as isize // Injected truncate failure
        }
        let tRes: isize = file_truncate(truncHandle as usize, engine.walCommittedOffset as u64)
        if tRes < 0 as isize {
            file_close(truncHandle as usize)
            file_unlock(engine.lockFd)
            file_close(engine.lockFd)
            return tRes // Failed to truncate torn tail
        }
        if fs_exists(path + "/.noesql_testing_faults_enabled") && fs_exists(path + "/FAULT_SYNC_FAIL.flag") {
            file_close(truncHandle as usize)
            file_unlock(engine.lockFd)
            file_close(engine.lockFd)
            return -12 as isize // Injected sync failure
        }
        let sRes: isize = file_sync(truncHandle as usize)
        file_close(truncHandle as usize)
        if sRes < 0 as isize {
            file_unlock(engine.lockFd)
            file_close(engine.lockFd)
            return sRes // Failed to sync repaired WAL
        }
    }

    // If every transaction in WAL was already captured in the base snapshot (e.g. crash interrupted truncation),
    // cleanly truncate WAL to 0 now under the exclusive lock to complete the interrupted checkpoint.
    if engine.db.lastTxId > 0 as u64 && engine.lastTxId <= engine.db.lastTxId && engine.walCommittedOffset > 0 as usize {
        let consRes: isize = noeWalLedgerConsolidateWal(engine)
        if consRes != 0 as isize {
            file_unlock(engine.lockFd)
            file_close(engine.lockFd)
            return consRes
        }
        let cleanHandle: isize = file_open_replace(walPath)
        if !file_handle_valid(cleanHandle) {
            file_unlock(engine.lockFd)
            file_close(engine.lockFd)
            return -15 as isize // Failed to open WAL for checkpoint cleanup truncation
        }
        if fs_exists(path + "/.noesql_testing_faults_enabled") && fs_exists(path + "/FAULT_CLEANUP_SYNC_FAIL.flag") {
            file_close(cleanHandle as usize)
            file_unlock(engine.lockFd)
            file_close(engine.lockFd)
            return -16 as isize // Injected sync failure on checkpoint cleanup truncation
        }
        let cleanSyncRes: isize = file_sync(cleanHandle as usize)
        file_close(cleanHandle as usize)
        if cleanSyncRes < 0 as isize {
            file_unlock(engine.lockFd)
            file_close(engine.lockFd)
            return cleanSyncRes // Failed to sync cleaned WAL
        }
        engine.walCommittedOffset = 0 as usize
        engine.walBytesWritten = 0 as usize
    }

    // 4. Open WAL file in append mode for low-latency durability
    let h: isize = file_open_append(walPath)
    if !file_handle_valid(h) {
        file_unlock(engine.lockFd)
        file_close(engine.lockFd)
        return -3 as isize
    }
    engine.walFd = h as usize
    engine.walOpen = true
    engine.walBytesWritten = engine.walCommittedOffset
    noeWalSyncDirectory(path)

    // 5. Rebuild B-tree index on first table primary keys
    noeWalRebuildIndex(engine)

    file_unlock(engine.lockFd)
    return 0 as isize
}

export function noeWalEngineBegin(engine: *NoeWalEngine, tx: *NoeWalTx): isize {
    if engine == null || !engine.walOpen || tx == null { return -1 as isize }

    // Enforce strict single-writer transaction protocol via cross-process exclusive lock
    let lockRes: isize = file_lock(engine.lockFd, true)
    if lockRes < 0 as isize { return lockRes }

    // Refresh committed database state under the lock!
    let refRes: isize = noeWalEngineRefresh(engine)
    if refRes != 0 as isize {
        file_unlock(engine.lockFd)
        return refRes
    }

    // Synchronize physical file pointer and verified position under exclusive lock
    let endPos: isize = file_seek(engine.walFd, 0 as i64, file_seek_end())
    if endPos >= 0 as isize {
        engine.walCommittedOffset = endPos as usize
    }
    engine.walBytesWritten = engine.walCommittedOffset

    engine.lastTxId = engine.lastTxId + 1 as u64
    tx.txId = engine.lastTxId
    tx.sequence = 0 as u32
    tx.inProgress = true

    let i: usize = 0 as usize
    while i < 32 as usize {
        tx.imageDigest[i] = 0 as u8
        i = i + 1 as usize
    }

    let target: [u8; 128]
    let scratch: [u8; 128]
    let empty: [u8; 0]
    let frameLen: isize = noeWalEncodeFrame(slice(target), slice(scratch), noeWalBegin(), tx.txId, 0 as u32, slice(empty))
    if frameLen <= 0 as isize {
        file_unlock(engine.lockFd)
        return frameLen
    }

    let written: isize = file_write_all(engine.walFd, slice(&target[0], frameLen as usize))
    if written < 0 as isize {
        file_unlock(engine.lockFd)
        return written
    }
    engine.walBytesWritten = engine.walBytesWritten + frameLen as usize
    return 0 as isize
}

export function noeWalEngineExecute(engine: *NoeWalEngine, tx: *NoeWalTx, statement: string): isize {
    if engine == null || !engine.walOpen || tx == null || !tx.inProgress { return -1 as isize }

    // 1. Validate statement size against durable WAL frame capacity BEFORE memory execution
    let stmtLen: usize = textLength(statement)
    if stmtLen == 0 as usize { return 0 as isize }
    if stmtLen > 2000 as usize {
        // Reject oversized statement immediately: rollback transaction to release lock & prevent dangling state
        noeWalEngineRollback(engine, tx)
        return -115 as isize
    }

    let stmtBuf: [u8; 2048]
    let sLen: usize = noeWalEncodeString(statement, slice(stmtBuf))
    if sLen != stmtLen {
        noeWalEngineRollback(engine, tx)
        return -115 as isize // Truncation safety: encoded bytes must match string length
    }

    // 2. Execute statement in active memory
    let status: isize = noeExecuteStatement(&engine.db, statement)
    if status < 0 as isize {
        noeWalEngineRollback(engine, tx)
        return status
    }

    // 3. Update B-Tree index if table 0 row inserted
    if engine.db.tableCount > 0 as usize {
        let t: *NoeTableData = &engine.db.tables[0]
        if t.rowCount > 0 as usize {
            let lastRow: usize = t.rowCount - 1 as usize
            let cell: *NoeRowCell = &t.cells[lastRow * 16 as usize + 0 as usize]
            if !cell.isNull {
                noeBTreeInsert(&engine.primaryIndex, cell.intVal, lastRow)
            }
        }
    }

    // 4. Compute rolling SHA-256 hash chaining across multiple statements in this transaction
    let hashRes: isize = noeWalChainHash(&tx.imageDigest[0], &stmtBuf[0], sLen, &tx.imageDigest[0])
    if hashRes != 0 as isize {
        noeWalEngineRollback(engine, tx)
        return hashRes
    }

    // 5. Append WAL IMAGE frame with full verified statement payload
    let target: [u8; 2200]
    let scratch: [u8; 2200]
    tx.sequence = tx.sequence + 1 as u32
    let frameLen: isize = noeWalEncodeFrame(slice(target), slice(scratch), noeWalImage(), tx.txId, tx.sequence, slice(&stmtBuf[0], sLen))
    if frameLen <= 0 as isize {
        noeWalEngineRollback(engine, tx)
        return frameLen
    }

    let written: isize = file_write_all(engine.walFd, slice(&target[0], frameLen as usize))
    if written < 0 as isize {
        noeWalEngineRollback(engine, tx)
        return written
    }
    engine.walBytesWritten = engine.walBytesWritten + frameLen as usize

    return 0 as isize
}

export function noeWalEngineCommit(engine: *NoeWalEngine, tx: *NoeWalTx): isize {
    if engine == null || !engine.walOpen || tx == null || !tx.inProgress { return -1 as isize }

    let walPath: string = engine.dbPath + "/WAL.log"
    if !fs_exists(walPath) {
        if engine.walFd != 0 as usize {
            file_close(engine.walFd)
            engine.walFd = 0 as usize
        }
        engine.walOpen = false
        noeWalEngineRollback(engine, tx)
        return -17 as isize
    }
    let curInode: i64 = file_inode(engine.walFd)
    let curDev: i64 = file_dev(engine.walFd)
    let diskInode: i64 = fs_inode(walPath)
    let diskDev: i64 = fs_dev(walPath)
    if curInode <= 0 as i64 || curDev <= 0 as i64 || diskInode <= 0 as i64 || diskDev <= 0 as i64 || curDev != diskDev || curInode != diskInode {
        // Failed identity lookup or file replaced during active transaction -> fail closed & rollback memory!
        if engine.walFd != 0 as usize {
            file_close(engine.walFd)
            engine.walFd = 0 as usize
        }
        engine.walOpen = false
        noeWalEngineRollback(engine, tx)
        return -17 as isize
    }

    // Encode WAL COMMIT frame with authentic chained rolling SHA-256 hash of images
    let target: [u8; 128]
    let scratch: [u8; 128]
    tx.sequence = tx.sequence + 1 as u32
    let frameLen: isize = noeWalEncodeFrame(slice(target), slice(scratch), noeWalCommit(), tx.txId, tx.sequence, slice(tx.imageDigest))
    if frameLen <= 0 as isize {
        noeWalEngineRollback(engine, tx)
        return frameLen
    }

    let written: isize = file_write_all(engine.walFd, slice(&target[0], frameLen as usize))
    if written < 0 as isize {
        noeWalEngineRollback(engine, tx)
        return written
    }
    engine.walBytesWritten = engine.walBytesWritten + frameLen as usize

    // Durability sync barrier: sequential fsync on WAL log file descriptor
    let syncRes: isize = 0 as isize
    if fs_exists(engine.dbPath + "/.noesql_testing_faults_enabled") && fs_exists(engine.dbPath + "/FAULT_COMMIT_SYNC_FAIL.flag") {
        syncRes = -18 as isize
    } else {
        syncRes = file_sync(engine.walFd)
    }
    if syncRes < 0 as isize {
        // P0 Durability Rule:
        // A successful COMMIT frame write followed by a failed fsync leaves the transaction outcome ambiguous.
        // DO NOT call noeWalEngineRollback! Rollback would read back the written COMMIT frame from disk and replay it!
        // Instead:
        // 1. Mark the transaction inactive
        // 2. Quarantine the engine (engine.walOpen = false) so no further writes are accepted on this corrupted/uncertain handle
        // 3. Release the exclusive lock so other processes or cold restart can perform recovery
        // 4. Return -18 as isize (uncertain commit outcome)
        tx.inProgress = false
        engine.walOpen = false
        file_unlock(engine.lockFd)
        return -18 as isize
    }

    // Derive committed offset directly from verified physical position under lock
    let commitEnd: isize = file_position(engine.walFd)
    if commitEnd >= 0 as isize {
        engine.walCommittedOffset = commitEnd as usize
        engine.walBytesWritten = commitEnd as usize
    } else {
        engine.walCommittedOffset = engine.walBytesWritten
    }

    // Record committed outcome in durable ledger
    noeWalLedgerRecordOutcome(engine.dbPath, tx.txId, 1 as u32, false)

    // Release cross-process single-writer exclusive lock
    file_unlock(engine.lockFd)
    tx.inProgress = false

    // Auto-checkpoint when WAL reaches threshold:
    // Decouple transaction durability from maintenance result. A durable commit
    // is never reported as uncommitted. Mark engine unusable if WAL descriptor is closed.
    if engine.walBytesWritten >= engine.checkpointThreshold {
        let cpRes: isize = noeWalEngineCheckpoint(engine)
        engine.lastMaintenanceStatus = cpRes
        if cpRes < 0 as isize {
            if !file_handle_valid(engine.walFd as isize) || engine.walFd == 0 as usize {
                engine.walOpen = false
            }
        }
    }

    return 0 as isize
}

export function noeWalEngineRollback(engine: *NoeWalEngine, tx: *NoeWalTx): isize {
    if engine == null || tx == null || !tx.inProgress { return 0 as isize }
    tx.inProgress = false

    // Explicitly record aborted outcome in durable outcomes ledger
    noeWalLedgerRecordOutcome(engine.dbPath, tx.txId, 2 as u32, false)

    let revRes: isize = noeWalEngineRevert(engine)
    if revRes != 0 as isize {
        // If rollback cannot cleanly restore state, quarantine engine immediately!
        engine.walOpen = false
    }
    file_unlock(engine.lockFd)
    return revRes
}

export function noeWalEngineCheckpointLocked(engine: *NoeWalEngine, keepLocked: bool): isize {
    if engine == null || !engine.walOpen { return -1 as isize }

    // 1. Acquire lock for checkpointing
    let lockRes: isize = file_lock(engine.lockFd, true)
    if lockRes < 0 as isize { return lockRes }

    // 2. Refresh database state under the lock to include all committed writes
    let refRes: isize = noeWalEngineRefresh(engine)
    if refRes != 0 as isize {
        file_unlock(engine.lockFd)
        return refRes // PROHIBIT checkpointing if refresh/replay failed!
    }

    // 3. Persist current lastTxId into snapshot state
    engine.db.lastTxId = engine.lastTxId

    // 4. Flush complete active database memory to base .noedb snapshot
    let saveRes: isize = noeDbSaveV3(&engine.db, engine.dbPath)
    if saveRes != 0 as isize {
        file_unlock(engine.lockFd)
        return saveRes
    }
    engine.baseGeneration = engine.db.generation
    noeWalSyncDirectory(engine.dbPath)

    // Snapshot integrity validation before WAL retirement: verify newly saved snapshot can be reopened cleanly
    let verifyDb: NoeDatabaseState
    noeEngineInit(&verifyDb, "verify")
    let verifyStatus: isize = noeDbOpenV3(&verifyDb, engine.dbPath)
    if verifyStatus != 0 as isize {
        file_unlock(engine.lockFd)
        return -19 as isize // Snapshot integrity verification failed: WAL MUST NOT BE RETIRED!
    }
    // Strict state invariant check: generation, watermark and row counts must match expected in-memory state
    if verifyDb.generation != engine.db.generation || verifyDb.lastTxId != engine.db.lastTxId || verifyDb.tableCount != engine.db.tableCount {
        file_unlock(engine.lockFd)
        return -19 as isize
    }
    let vT: usize = 0 as usize
    while vT < engine.db.tableCount {
        if verifyDb.tables[vT].rowCount != engine.db.tables[vT].rowCount {
            file_unlock(engine.lockFd)
            return -19 as isize
        }
        vT = vT + 1 as usize
    }

    // Fault-Injection Hook: signal external test harness after snapshot publication, before WAL truncation
    if fs_exists(engine.dbPath + "/.noesql_testing_faults_enabled") && fs_exists(engine.dbPath + "/FAULT_CHECKPOINT_KILL.flag") {
        let sigFd: isize = file_open_create(engine.dbPath + "/SNAPSHOT_PUBLISHED.marker")
        if file_handle_valid(sigFd) {
            file_close(sigFd as usize)
        }
        print("FAULT_INJECTED_CHECKPOINT_SNAPSHOT_PUBLISHED")
        file_flush(1 as usize)
        // Wait for external test harness to send true OS SIGKILL
        let waitIter: usize = 0 as usize
        while waitIter < 1000 as usize {
            thread_sleep_millis(10 as i64)
            waitIter = waitIter + 1 as usize
        }
    }

    // Consolidate verified transaction outcomes into durable ledger before WAL truncation
    let consRes: isize = noeWalLedgerConsolidateWal(engine)
    if consRes != 0 as isize {
        file_unlock(engine.lockFd)
        return consRes // ABORT CHECKPOINT: WAL MUST NOT BE RETIRED!
    }

    // 5. Truncate WAL file to 0 bytes
    file_close(engine.walFd)
    engine.walFd = 0 as usize
    let walPath: string = engine.dbPath + "/WAL.log"
    let repHandle: isize = file_open_replace(walPath)
    if !file_handle_valid(repHandle) {
        engine.walOpen = false
        file_unlock(engine.lockFd)
        return -3 as isize
    }
    if fs_exists(engine.dbPath + "/.noesql_testing_faults_enabled") && fs_exists(engine.dbPath + "/FAULT_CHECKPOINT_SYNC_FAIL.flag") {
        file_close(repHandle as usize)
        engine.walOpen = false
        file_unlock(engine.lockFd)
        return -13 as isize // Injected sync failure on checkpoint WAL truncation
    }
    let syncTruncRes: isize = file_sync(repHandle as usize)
    file_close(repHandle as usize)
    if syncTruncRes < 0 as isize {
        engine.walOpen = false
        file_unlock(engine.lockFd)
        return syncTruncRes
    }

    // 6. Re-open WAL in append mode
    let appHandle: isize = file_open_append(walPath)
    if !file_handle_valid(appHandle) {
        engine.walOpen = false
        file_unlock(engine.lockFd)
        return -4 as isize
    }
    engine.walFd = appHandle as usize
    engine.walBytesWritten = 0 as usize
    engine.walCommittedOffset = 0 as usize
    noeWalSyncDirectory(engine.dbPath)

    if !keepLocked {
        file_unlock(engine.lockFd)
    }
    return 0 as isize
}

export function noeWalEngineCheckpoint(engine: *NoeWalEngine): isize {
    return noeWalEngineCheckpointLocked(engine, false)
}

export function noeWalEngineClose(engine: *NoeWalEngine): isize {
    if engine == null { return 0 as isize }
    let cpStatus: isize = 0 as isize
    if engine.walOpen {
        cpStatus = noeWalEngineCheckpoint(engine)
    }
    if engine.walFd != 0 as usize {
        file_close(engine.walFd)
        engine.walFd = 0 as usize
    }
    if engine.lockFd != 0 as usize {
        file_close(engine.lockFd)
        engine.lockFd = 0 as usize
    }
    engine.walOpen = false
    return cpStatus
}

// ----------------------------------------------------------------------------
// Multi-Process Daemon & Client-Server Request Handling
// ----------------------------------------------------------------------------

function noeWalScanTxOutcome(engine: *NoeWalEngine, targetTxId: u64): int {
    if engine == null || targetTxId == 0 as u64 { return -1 } // Unknown
    if targetTxId > engine.lastTxId {
        return 0 // Beyond watermark or never began -> Aborted
    }

    // 1. Check active WAL for authentic, cryptographically verified commit frame
    let walOutcome: int = noeWalScanAuthenticatedCommit(engine, targetTxId)
    if walOutcome == 1 {
        return 1 // Verifiably committed in active WAL
    }
    if walOutcome == -1 {
        return -1 // I/O read failure or corrupt WAL header -> unknown
    }

    // 2. Check durable outcomes ledger (survives checkpointing and WAL truncation)
    let ledgerPath: string = engine.dbPath + "/tx_outcomes.log"
    if targetTxId <= engine.db.lastTxId && !fs_exists(ledgerPath) {
        return -1 // Historical ledger missing -> outcome unknown! (NEVER false aborted!)
    }

    let ledgerOutcome: int = noeWalLedgerQueryOutcome(engine.dbPath, targetTxId)
    if ledgerOutcome == 1 {
        return 1 // Verifiably committed in durable ledger
    }
    if ledgerOutcome == 2 {
        return 0 // Explicitly recorded aborted / rolled back in durable ledger
    }
    if ledgerOutcome < 0 {
        return -1 // Ledger read error / corrupt / missing / checksum mismatch -> unknown
    }

    // Neither active WAL nor durable ledger has explicit record of this transaction.
    // If targetTxId <= engine.db.lastTxId, this transaction belonged to a checkpointed snapshot,
    // but its historical outcome is missing from the ledger: its outcome CANNOT be established!
    if targetTxId <= engine.db.lastTxId {
        return -1 // Historical evidence missing -> unknown (NEVER false aborted!)
    }

    // If targetTxId > engine.db.lastTxId, it belongs to active WAL era (post-checkpoint),
    // and active WAL authenticated scan verified it never committed:
    return 0 // Aborted
}

export function noeDaemonReconcileTx(engine: *NoeWalEngine, txId: u64): string {
    if engine == null { return "ERROR:null_engine" }

    // Synchronize under exclusive lock to protect against concurrent checkpoints & writers
    let lockRes: isize = file_lock(engine.lockFd, true)
    if lockRes < 0 as isize {
        return "RECONCILE_ERROR:lock_failed"
    }

    let rStatus: isize = noeWalEngineRefresh(engine)
    if rStatus != 0 as isize {
        file_unlock(engine.lockFd)
        return "RECONCILE_ERROR:" + noeIntToString(rStatus as i64)
    }

    let outcome: int = noeWalScanTxOutcome(engine, txId)
    file_unlock(engine.lockFd)

    if outcome == 1 {
        return "RECONCILED:committed:tx=" + noeIntToString(txId as i64)
    }
    if outcome == 0 {
        return "RECONCILED:aborted:tx=" + noeIntToString(txId as i64)
    }
    return "RECONCILED:unknown:tx=" + noeIntToString(txId as i64)
}

export function noeDaemonHandleRequest(engine: *NoeWalEngine, request: string): string {
    if engine == null || request == "" { return "ERROR:empty_request" }

    // Check for reconciliation request: "RECONCILE:<txId>"
    let buf: [u8; 1024]
    let rLen: usize = stringToBytes(request, &buf[0], 1024 as usize)
    if rLen > 10 as usize && buf[0] == 82 as u8 && buf[1] == 69 as u8 && buf[2] == 67 as u8 &&
       buf[3] == 79 as u8 && buf[4] == 78 as u8 && buf[5] == 67 as u8 && buf[6] == 73 as u8 &&
       buf[7] == 76 as u8 && buf[8] == 69 as u8 && buf[9] == 58 as u8 { // "RECONCILE:"
        let txIdStr: string = bytesToString(&buf[10], rLen - 10 as usize)
        let parsedId: i64 = noeParseI64(txIdStr)
        if parsedId > 0 as i64 {
            return noeDaemonReconcileTx(engine, parsedId as u64)
        }
        return "ERROR:invalid_reconcile_tx"
    }

    let tx: NoeWalTx
    let bStatus: isize = noeWalEngineBegin(engine, &tx)
    if bStatus != 0 as isize { return "ERROR:begin_failed:" + noeIntToString(bStatus as i64) }

    let eStatus: isize = noeWalEngineExecute(engine, &tx, request)
    if eStatus != 0 as isize { return "ERROR:exec_failed:" + noeIntToString(eStatus as i64) }

    let cStatus: isize = noeWalEngineCommit(engine, &tx)
    if cStatus == -18 as isize {
        // Expose unambiguous UNCERTAIN_COMMIT outcome with transaction ID for client reconciliation
        return "UNCERTAIN_COMMIT:tx=" + noeIntToString(tx.txId as i64)
    }
    if cStatus != 0 as isize {
        return "ERROR:commit_failed:" + noeIntToString(cStatus as i64)
    }

    return "OK:tx=" + noeIntToString(tx.txId as i64)
}


