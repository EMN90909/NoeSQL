module noqeri.database.noesql.wal

// NoeSQL WAL v1 byte framing (little-endian, portable):
// magic NWAL (4), version u16 (2), type u8 (1), flags u8 (1),
// transaction u64 (8), sequence u32 (4), payload size u32 (4),
// SHA-256 digest (32), payload. BEGIN(0 bytes), IMAGE, COMMIT(32-byte
// SHA-256 of image). Commit becomes durable ONLY after WAL fsync and WAL
// directory fsync. Host services are for cryptographic hash and filesystem;
// format and replay policy remain Noqeri-owned. No dynamic allocation.

extern function noeHostSha256(source: *u8, length: usize, digest: *u8, capacity: usize): isize

record NoeWalFrame {
    kind: int
    transaction: u64
    sequence: u32
    payloadStart: usize
    payloadSize: usize
    end: usize
}

record NoeWalRecovery {
    status: int
    transaction: u64
    imageStart: usize
    imageLength: usize
    frames: usize
}

export function noeWalHeaderSize(): usize { return 56 as usize }
export function noeWalMaximumImage(): usize { return 16777216 as usize }
export function noeWalBegin(): int { return 1 }
export function noeWalImage(): int { return 2 }
export function noeWalCommit(): int { return 3 }
export function noeWalFoundCommit(): int { return 1 }
export function noeWalUncommitted(): int { return 0 }
export function noeWalCorrupt(): int { return -1 }

export function noeWalChainHash(currentDigest: *u8, payload: *u8, payloadLen: usize, outDigest: *u8): isize {
    let buf: [u8; 4128]
    if payloadLen > 4096 as usize { return -1 as isize }
    let i: usize = 0 as usize
    while i < 32 as usize {
        buf[i] = currentDigest[i]
        i = i + 1 as usize
    }
    i = 0 as usize
    while i < payloadLen {
        buf[32 as usize + i] = payload[i]
        i = i + 1 as usize
    }
    return noeHostSha256(&buf[0], 32 as usize + payloadLen, outDigest, 32 as usize)
}

export function noeWalComputeSha256(source: *u8, length: usize, digest: *u8, capacity: usize): isize {
    return noeHostSha256(source, length, digest, capacity)
}

export function noeWalPutNumber(bytes: []u8, at: usize, count: usize, value: u64): bool {
    if at > len(bytes) || count > len(bytes) - at { return false }
    let n: u64 = value
    let i: usize = 0 as usize
    while i < count {
        bytes[at + i] = (n % 256 as u64) as u8
        n = n / 256 as u64
        i = i + 1 as usize
    }
    return n == 0 as u64
}

export function noeWalGetNumber(bytes: []u8, at: usize, count: usize): u64 {
    let n: u64 = 0 as u64
    let i: usize = count
    while i > 0 as usize {
        i = i - 1 as usize
        n = n * 256 as u64 + bytes[at + i] as u64
    }
    return n
}

export function noeWalEncodeFrame(target: []u8, scratch: []u8, kind: int, transaction: u64, sequence: u32, payload: []u8): isize {
    if kind < noeWalBegin() || kind > noeWalCommit() || transaction == 0 as u64 { return -1 as isize }
    if len(payload) > noeWalMaximumImage() || len(payload) > 4294967295 as usize { return -2 as isize }
    if len(target) < 56 as usize || len(payload) > len(target) - 56 as usize { return -3 as isize }
    if len(scratch) < 24 as usize || len(payload) > len(scratch) - 24 as usize { return -4 as isize }

    target[0] = 78 as u8
    target[1] = 87 as u8
    target[2] = 65 as u8
    target[3] = 76 as u8
    if !noeWalPutNumber(target, 4 as usize, 2 as usize, 1 as u64) { return -5 as isize }
    target[6] = kind as u8
    target[7] = 0 as u8
    if !noeWalPutNumber(target, 8 as usize, 8 as usize, transaction) { return -5 as isize }
    if !noeWalPutNumber(target, 16 as usize, 4 as usize, sequence as u64) { return -5 as isize }
    if !noeWalPutNumber(target, 20 as usize, 4 as usize, len(payload) as u64) { return -5 as isize }

    let i: usize = 0 as usize
    while i < 24 as usize { scratch[i] = target[i] i = i + 1 as usize }
    i = 0 as usize
    while i < len(payload) {
        scratch[24 as usize + i] = payload[i]
        target[56 as usize + i] = payload[i]
        i = i + 1 as usize
    }
    if noeHostSha256(&scratch[0], 24 as usize + len(payload), &target[24], 32 as usize) != 0 as isize { return -6 as isize }
    return (56 as usize + len(payload)) as isize
}

// Return 1 for an incomplete, uncommitted tail; negative for corruption.
export function noeWalDecodeFrame(source: []u8, offset: usize, scratch: []u8, out: *NoeWalFrame): isize {
    if out == null || offset > len(source) { return -1 as isize }
    if len(source) - offset < 56 as usize { return 1 as isize }
    if source[offset] != 78 as u8 || source[offset + 1 as usize] != 87 as u8 || source[offset + 2 as usize] != 65 as u8 || source[offset + 3 as usize] != 76 as u8 { return -2 as isize }
    if noeWalGetNumber(source, offset + 4 as usize, 2 as usize) != 1 as u64 || source[offset + 7 as usize] != 0 as u8 { return -3 as isize }
    let size: usize = noeWalGetNumber(source, offset + 20 as usize, 4 as usize) as usize
    if size > noeWalMaximumImage() { return -4 as isize }
    if size > len(source) - offset - 56 as usize { return 1 as isize }
    if len(scratch) < 24 as usize || size > len(scratch) - 24 as usize { return -5 as isize }

    let i: usize = 0 as usize
    while i < 24 as usize { scratch[i] = source[offset + i] i = i + 1 as usize }
    i = 0 as usize
    while i < size { scratch[24 as usize + i] = source[offset + 56 as usize + i] i = i + 1 as usize }
    let hash: [u8; 32]
    if noeHostSha256(&scratch[0], 24 as usize + size, &hash[0], 32 as usize) != 0 as isize { return -6 as isize }
    i = 0 as usize
    let mismatch: u8 = 0 as u8
    while i < 32 as usize {
        if hash[i] != source[offset + 24 as usize + i] { mismatch = 1 as u8 }
        i = i + 1 as usize
    }
    if mismatch != 0 as u8 { return -7 as isize }

    out.kind = source[offset + 6 as usize] as int
    out.transaction = noeWalGetNumber(source, offset + 8 as usize, 8 as usize)
    out.sequence = noeWalGetNumber(source, offset + 16 as usize, 4 as usize) as u32
    out.payloadStart = offset + 56 as usize
    out.payloadSize = size
    out.end = offset + 56 as usize + size
    return 0 as isize
}

// Scans the next committed transaction in WAL starting at fromOffset.
// Returns:
//   1: Successfully scanned and cryptographically verified a committed transaction.
//   0: Clean end of log or uncommitted tail (writer interrupted before commit).
//  <0: Corrupted frame or cryptographic hash mismatch.
export function noeWalScanNext(source: []u8, fromOffset: usize, scratch: []u8, outTx: *u64, outImageStart: *usize, outImageLen: *usize, outNextOffset: *usize): int {
    let currOffset: usize = fromOffset
    while currOffset < len(source) {
        // 1. Decode BEGIN frame
        let fBegin: NoeWalFrame
        let stBegin: isize = noeWalDecodeFrame(source, currOffset, scratch, &fBegin)
        if stBegin == 1 as isize { return 0 } // incomplete tail
        if stBegin < 0 as isize { return stBegin as int }
        if fBegin.kind != noeWalBegin() || fBegin.sequence != 0 as u32 || fBegin.transaction == 0 as u64 {
            return -20
        }
        let txId: u64 = fBegin.transaction

        // 2. Decode IMAGE frame
        if fBegin.end >= len(source) { return 0 }
        let fImage: NoeWalFrame
        let stImage: isize = noeWalDecodeFrame(source, fBegin.end, scratch, &fImage)
        if stImage == 1 as isize { return 0 }
        if stImage < 0 as isize { return stImage as int }

        // If another BEGIN appears immediately, prior BEGIN was aborted without IMAGE
        if fImage.kind == noeWalBegin() {
            currOffset = fBegin.end
            continue
        }

        if fImage.kind != noeWalImage() || fImage.sequence != 1 as u32 || fImage.transaction != txId {
            return -21
        }

        // 3. Decode COMMIT frame
        if fImage.end >= len(source) { return 0 }
        let fCommit: NoeWalFrame
        let stCommit: isize = noeWalDecodeFrame(source, fImage.end, scratch, &fCommit)
        if stCommit == 1 as isize { return 0 } // incomplete commit frame
        if stCommit < 0 as isize { return stCommit as int }

        // If another BEGIN appears after IMAGE, prior transaction was aborted before COMMIT
        if fCommit.kind == noeWalBegin() {
            currOffset = fImage.end
            continue
        }

        if fCommit.kind != noeWalCommit() || fCommit.sequence != 2 as u32 || fCommit.transaction != txId || fCommit.payloadSize != 32 as usize {
            return -22
        }

        // 4. Verify cryptographic SHA-256 digest of image against COMMIT payload
        let digest: [u8; 32]
        if noeHostSha256(&source[fImage.payloadStart], fImage.payloadSize, &digest[0], 32 as usize) != 0 as isize {
            return -23
        }
        let i: usize = 0 as usize
        while i < 32 as usize {
            if digest[i] != source[fCommit.payloadStart + i] {
                return -24 // Commit digest mismatch: data corruption or counterfeit commit!
            }
            i = i + 1 as usize
        }

        outTx[0] = txId
        outImageStart[0] = fImage.payloadStart
        outImageLen[0] = fImage.payloadSize
        outNextOffset[0] = fCommit.end
        return 1
    }
    return 0
}

// Multi-transaction recovery verification
export function noeWalRecover(source: []u8, scratch: []u8, out: *NoeWalRecovery): isize {
    if out == null || len(source) > noeWalMaximumImage() + 232 as usize { return -1 as isize }
    out.status = noeWalUncommitted()
    out.transaction = 0 as u64
    out.imageStart = 0 as usize
    out.imageLength = 0 as usize
    out.frames = 0 as usize

    let offset: usize = 0 as usize
    let txCount: usize = 0 as usize

    while offset < len(source) {
        let txId: u64 = 0 as u64
        let imgStart: usize = 0 as usize
        let imgLen: usize = 0 as usize
        let nextOff: usize = 0 as usize

        let st: int = noeWalScanNext(source, offset, scratch, &txId, &imgStart, &imgLen, &nextOff)
        if st == 1 {
            // Committed transaction verified
            txCount = txCount + 1 as usize
            out.transaction = txId
            out.imageStart = imgStart
            out.imageLength = imgLen
            out.frames = txCount * 3 as usize
            out.status = noeWalFoundCommit()
            offset = nextOff
        } else if st == 0 {
            // Clean uncommitted tail or EOF
            return 0 as isize
        } else {
            // Corruption detected
            out.status = noeWalCorrupt()
            return st as isize
        }
    }
    return 0 as isize
}
