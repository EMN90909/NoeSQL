import "../Database/noesql_engine.noqeri"
import "../Database/noesql_wal_engine.noqeri"
import "../Database/noesql_btree.noqeri"
import "../../Noqeri/Lib/std/file.noqeri"
import "../../Noqeri/Lib/std/fs.noqeri"

// NoeSQL Production Operational Safeguards CLI Tools
// Commands: doctor, check, backup, restore, explain, query
// 100% Pure Noqeri Native Execution

function noeCliReadLine(path: string, targetLine: usize): string {
    let h: isize = file_open_read(path)
    if !file_handle_valid(h) { return "" }
    let fSizeIs: isize = file_size(h as usize)
    if fSizeIs <= 0 as isize { file_close(h as usize); return "" }
    let buf: [u8; 4096]
    let toRead: usize = fSizeIs as usize
    if toRead > 4096 as usize { toRead = 4096 as usize }
    let r: isize = file_read_exact(h as usize, slice(&buf[0], toRead))
    file_close(h as usize)
    if r <= 0 as isize { return "" }

    let lineIdx: usize = 0 as usize
    let start: usize = 0 as usize
    let i: usize = 0 as usize
    while i <= toRead {
        if i == toRead || buf[i] == 10 as u8 || buf[i] == 13 as u8 {
            if i > start {
                if lineIdx == targetLine {
                    return bytesToString(&buf[start], i - start)
                }
                lineIdx = lineIdx + 1 as usize
            }
            if i < toRead && (buf[i] == 10 as u8 || buf[i] == 13 as u8) {
                if i + 1 as usize < toRead && buf[i] == 13 as u8 && buf[i + 1 as usize] == 10 as u8 {
                    i = i + 1 as usize
                }
            }
            start = i + 1 as usize
        }
        i = i + 1 as usize
    }
    return ""
}

export function noeCliWriteStatusFile(path: string, code: isize): void {
    if path == "" { return }
    let h: isize = file_open_replace(path)
    if file_handle_valid(h) {
        let s: string = noeIntToString(code as i64) + "\n"
        let buf: [u8; 64]
        let sLen: usize = stringToBytes(s, &buf[0], 64 as usize)
        file_write_all(h as usize, slice(&buf[0], sLen))
        file_sync(h as usize)
        file_close(h as usize)
    }
}

export function noeCliDoctor(dbPath: string): isize {
    if dbPath == "" { dbPath = "production.noedb" }
    print("================================================================")
    print("  NoeSQL Database Diagnostic Doctor")
    print("  Target Database: " + dbPath)
    print("================================================================")

    if !fs_exists(dbPath) {
        print("[-] CRITICAL: Database directory does not exist: " + dbPath)
        return -1 as isize
    }
    if !fs_is_directory(dbPath) {
        print("[-] CRITICAL: Target path is not a directory: " + dbPath)
        return -1 as isize
    }
    print("[+] Database directory accessible: " + dbPath)

    // Check HEAD file
    let headPath: string = dbPath + "/HEAD"
    if !fs_exists(headPath) {
        print("[-] CRITICAL: Missing HEAD file in " + dbPath)
        return -2 as isize
    }
    let gen: u64 = noeReadActiveGeneration(dbPath)
    if gen == 0 as u64 {
        print("[-] CRITICAL: Invalid active generation in HEAD")
        return -2 as isize
    }
    print("[+] Active HEAD: Generation " + noeIntToString(gen as i64))

    // Check active snapshot generation file
    let snapPath: string = dbPath + "/versions/generation-" + noeIntToString(gen as i64) + ".pages"
    if !fs_exists(snapPath) {
        print("[-] CRITICAL: Snapshot page file missing: " + snapPath)
        return -3 as isize
    }
    let snapSize: isize = fs_file_size(snapPath)
    if snapSize < 64 as isize {
        print("[-] CRITICAL: Snapshot page file truncated (< 64 bytes): " + snapPath)
        return -4 as isize
    }
    print("[+] Snapshot page file present: " + snapPath + " (" + noeIntToString(snapSize as i64) + " bytes)")

    // Genuinely validate database snapshot using noeDbOpenV3:
    // This computes and verifies the 32-byte SHA-256 checksum trailer and deserializes the catalog
    let testDb: NoeDatabaseState
    noeEngineInit(&testDb, "doctor_check")
    let openStatus: isize = noeDbOpenV3(&testDb, dbPath)
    if openStatus != 0 as isize {
        print("[-] CRITICAL: Snapshot open/integrity check failed (Status: " + noeIntToString(openStatus as i64) + ")")
        return openStatus
    }
    print("[+] Snapshot SHA-256 Checksum: VERIFIED (100% Valid)")
    print("[+] Relational Catalog: " + noeIntToString(testDb.tableCount as i64) + " tables")

    let t: usize = 0 as usize
    while t < testDb.tableCount {
        print("    -> Table '" + testDb.tables[t].name + "': " + noeIntToString(testDb.tables[t].rowCount as i64) + " rows, " + noeIntToString(testDb.tables[t].fieldCount as i64) + " columns")
        t = t + 1 as usize
    }

    // Check outcomes ledger with cryptographic record verification
    let ledgerPath: string = dbPath + "/tx_outcomes.log"
    if fs_exists(ledgerPath) {
        let legSize: isize = fs_file_size(ledgerPath)
        if legSize < 32 as isize || (legSize as usize - 32 as usize) % 32 as usize != 0 as usize {
            print("[-] WARNING: Outcome ledger has non-standard size: " + noeIntToString(legSize as i64) + " bytes")
            return -5 as isize
        }
        let legFd: isize = file_open_read(ledgerPath)
        if !file_handle_valid(legFd) {
            print("[-] CRITICAL: Cannot read outcome ledger: " + ledgerPath)
            return -6 as isize
        }
        let legHdr: [u8; 32]
        let rHdr: isize = file_read_exact(legFd as usize, slice(legHdr))
        if rHdr != 32 as isize || legHdr[0] != 78 as u8 || legHdr[1] != 81 as u8 || legHdr[2] != 84 as u8 || legHdr[3] != 76 as u8 ||
           legHdr[4] != 48 as u8 || legHdr[5] != 48 as u8 || legHdr[6] != 48 as u8 || legHdr[7] != 50 as u8 {
            file_close(legFd as usize)
            print("[-] CRITICAL: Outcome ledger invalid header magic")
            return -7 as isize
        }
        let legEntries: usize = (legSize as usize - 32 as usize) / 32 as usize
        let eIdx: usize = 0 as usize
        let corruptRecords: usize = 0 as usize
        while eIdx < legEntries {
            let recBuf: [u8; 32]
            let rRec: isize = file_read_exact(legFd as usize, slice(recBuf))
            if rRec != 32 as isize {
                corruptRecords = corruptRecords + 1 as usize
                break
            }
            let recSha: [u8; 32]
            noeWalComputeSha256(&recBuf[0], 16 as usize, &recSha[0], 32 as usize)
            let cFail: bool = false
            let si: usize = 0 as usize
            while si < 16 as usize {
                if recBuf[16 as usize + si] != recSha[si] { cFail = true }
                si = si + 1 as usize
            }
            if cFail { corruptRecords = corruptRecords + 1 as usize }
            eIdx = eIdx + 1 as usize
        }
        file_close(legFd as usize)
        if corruptRecords > 0 as usize {
            print("[-] CRITICAL: Outcome ledger contains " + noeIntToString(corruptRecords as i64) + " corrupt checksum records!")
            return -8 as isize
        }
        print("[+] Outcomes Ledger: NQTL0002 (" + noeIntToString(legEntries as i64) + " records, all SHA-256 verified)")
    } else {
        print("[*] Outcomes Ledger: Not initialized yet (clean state)")
    }

    // Check WAL log
    let walPath: string = dbPath + "/WAL.log"
    let walActive: bool = false
    if fs_exists(walPath) {
        let walSize: isize = fs_file_size(walPath)
        if walSize == 0 as isize {
            print("[+] Write-Ahead Log: CLEAN (0 bytes, fully checkpointed)")
        } else {
            walActive = true
            print("[*] Write-Ahead Log: ACTIVE (" + noeIntToString(walSize as i64) + " uncheckpointed bytes)")
        }
    } else {
        print("[*] Write-Ahead Log: None (clean)")
    }

    // Check Lock state
    let lockPath: string = dbPath + "/WAL.lck"
    if fs_exists(lockPath) {
        let lockFd: isize = file_open_create(lockPath)
        if file_handle_valid(lockFd) {
            let tryLock: isize = file_lock(lockFd as usize, true)
            if tryLock == 0 as isize {
                file_unlock(lockFd as usize)
                file_close(lockFd as usize)
                print("[+] Lock State: UNLOCKED (Idle, ready for connections)")
            } else {
                file_close(lockFd as usize)
                print("[*] Lock State: LOCKED (Active daemon/writer holds exclusive lock)")
            }
        }
    } else {
        print("[+] Lock State: UNLOCKED (No lock file present)")
    }

    print("----------------------------------------------------------------")
    if walActive {
        print("  Overall Status: SNAPSHOT & LEDGER VERIFIED (Active WAL Unverified)")
    } else {
        print("  Overall Status: SNAPSHOT & LEDGER VERIFIED (Clean State)")
    }
    print("  Scope: Snapshot SHA-256 integrity & outcome ledger verified.")
    print("================================================================\n")
    return 0 as isize
}

export function noeCliCheck(dbPath: string): isize {
    if dbPath == "" { dbPath = "production.noedb" }
    print("================================================================")
    print("  NoeSQL Relational Integrity & B+Tree Checker")
    print("  Target: " + dbPath)
    print("================================================================")

    let engine: NoeWalEngine
    let oRes: isize = noeWalEngineOpen(&engine, dbPath)
    if oRes != 0 as isize {
        print("[-] Check Failed: Could not open database (Status: " + noeIntToString(oRes as i64) + ")")
        return oRes
    }

    print("[+] Database Opened Cleanly (Generation: " + noeIntToString(engine.baseGeneration as i64) + ", LastTxId: " + noeIntToString(engine.lastTxId as i64) + ")")
    print("[+] Table Count: " + noeIntToString(engine.db.tableCount as i64))

    let tIdx: usize = 0 as usize
    while tIdx < engine.db.tableCount {
        let t: *NoeTableData = &engine.db.tables[tIdx]
        print("  Table [" + noeIntToString(tIdx as i64) + "] '" + t.name + "': " + noeIntToString(t.rowCount as i64) + " rows")

        // Verify primary key B+Tree if table has rows
        if tIdx == 0 as usize && t.rowCount > 0 as usize {
            let r: usize = 0 as usize
            let verifiedKeys: usize = 0 as usize
            while r < t.rowCount {
                let cell: *NoeRowCell = &t.cells[r * 16 as usize + 0 as usize]
                if !cell.isNull {
                    let sRes: isize = noeBTreeSearch(&engine.primaryIndex, cell.intVal)
                    if sRes < 0 as isize || (sRes as usize) != r {
                        print("[-] B+Tree Index Mismatch on row " + noeIntToString(r as i64) + " key " + noeIntToString(cell.intVal))
                        noeWalEngineClose(&engine)
                        return -10 as isize
                    }
                    verifiedKeys = verifiedKeys + 1 as usize
                }
                r = r + 1 as usize
            }
            print("    [+] Primary Key B+Tree: " + noeIntToString(verifiedKeys as i64) + " keys verified in O(log N) lookup")
        }

        // Verify Foreign Key constraints for this table
        let f: usize = 0 as usize
        while f < t.fieldCount {
            let field: *NoeFieldDef = &t.fields[f]
            if field.refTable != "" {
                let refTIdx: isize = noeFindTable(&engine.db, field.refTable)
                if refTIdx < 0 as isize {
                    print("[-] Broken Foreign Key: Table '" + t.name + "' references non-existent table '" + field.refTable + "'")
                    noeWalEngineClose(&engine)
                    return -11 as isize
                }
                let refT: *NoeTableData = &engine.db.tables[refTIdx as usize]
                let rk: usize = 0 as usize
                while rk < t.rowCount {
                    let c: *NoeRowCell = &t.cells[rk * 16 as usize + f]
                    if !c.isNull {
                        let fkVal: i64 = c.intVal
                        let foundRef: bool = false
                        let tr: usize = 0 as usize
                        while tr < refT.rowCount {
                            let pkCell: *NoeRowCell = &refT.cells[tr * 16 as usize + 0 as usize]
                            if !pkCell.isNull && pkCell.intVal == fkVal {
                                foundRef = true
                                break
                            }
                            tr = tr + 1 as usize
                        }
                        if !foundRef {
                            print("[-] Orphaned Foreign Key reference in table '" + t.name + "' row " + noeIntToString(rk as i64) + " -> " + noeIntToString(fkVal))
                            noeWalEngineClose(&engine)
                            return -12 as isize
                        }
                    }
                    rk = rk + 1 as usize
                }
                print("    [+] Foreign Key '" + field.name + "' -> '" + field.refTable + "': 100% referential integrity")
            }
            f = f + 1 as usize
        }

        tIdx = tIdx + 1 as usize
    }

    noeWalEngineClose(&engine)
    print("----------------------------------------------------------------")
    print("  Relational Consistency & Index Verification: ALL PASSED")
    print("================================================================\n")
    return 0 as isize
}

export function noeCliBackup(srcPath: string, targetPath: string): isize {
    if srcPath == "" || targetPath == "" {
        print("[-] Usage: noesql backup <sourceDb> <targetDb>")
        return -1 as isize
    }
    if !fs_exists(srcPath) {
        print("[-] Source database does not exist: " + srcPath)
        return -2 as isize
    }
    if fs_exists(targetPath) {
        print("[-] Target backup path already exists (refusing to overwrite): " + targetPath)
        return -3 as isize
    }

    print("[*] Initiating locked, consistent point-in-time backup...")
    print("    Source: " + srcPath)
    print("    Target: " + targetPath)

    let engine: NoeWalEngine
    let oRes: isize = noeWalEngineOpen(&engine, srcPath)
    if oRes != 0 as isize {
        print("[-] Failed to open source database (Status: " + noeIntToString(oRes as i64) + ")")
        return oRes
    }

    // Flush checkpoint under lock and HOLD THE LOCK CONTINUOUSLY throughout the backup capture!
    let cpRes: isize = noeWalEngineCheckpointLocked(&engine, true)
    if cpRes != 0 as isize {
        print("[-] Failed to checkpoint source database (Status: " + noeIntToString(cpRes as i64) + ")")
        noeWalEngineClose(&engine)
        return cpRes
    }

    // Prepare staging directory for atomic publication
    let stagingPath: string = targetPath + ".staging"
    if fs_exists(stagingPath) {
        fs_remove_tree(stagingPath)
    }

    let mk1: isize = fs_ensure_directory(stagingPath)
    let mk2: isize = fs_ensure_directory(stagingPath + "/versions")
    if mk1 < 0 as isize || mk2 < 0 as isize {
        print("[-] Failed to create backup directories")
        file_unlock(engine.lockFd)
        noeWalEngineClose(&engine)
        fs_remove_tree(stagingPath)
        return -4 as isize
    }

    let currentGen: u64 = noeReadActiveGeneration(srcPath)
    let genFileName: string = "/versions/generation-" + noeIntToString(currentGen as i64) + ".pages"

    let cpHead: isize = fs_copy_file_replace(srcPath + "/HEAD", stagingPath + "/HEAD")
    let cpPages: isize = fs_copy_file_replace(srcPath + genFileName, stagingPath + genFileName)
    if cpHead < 0 as isize || cpPages < 0 as isize {
        print("[-] Failed to copy snapshot files")
        file_unlock(engine.lockFd)
        noeWalEngineClose(&engine)
        fs_remove_tree(stagingPath)
        return -5 as isize
    }

    // Copy outcomes ledger if present
    if fs_exists(srcPath + "/tx_outcomes.log") {
        let cpLeg: isize = fs_copy_file_replace(srcPath + "/tx_outcomes.log", stagingPath + "/tx_outcomes.log")
        if cpLeg < 0 as isize {
            print("[-] Failed to copy outcome ledger")
            file_unlock(engine.lockFd)
            noeWalEngineClose(&engine)
            fs_remove_tree(stagingPath)
            return -6 as isize
        }
    }

    // Initialize clean WAL in staging
    let twHandle: isize = file_open_create(stagingPath + "/WAL.log")
    if !file_handle_valid(twHandle) {
        print("[-] Failed to create empty WAL log in backup")
        file_unlock(engine.lockFd)
        noeWalEngineClose(&engine)
        fs_remove_tree(stagingPath)
        return -7 as isize
    }
    let fsWalRes: isize = file_sync(twHandle as usize)
    file_close(twHandle as usize)
    if fsWalRes < 0 as isize {
        print("[-] Failed to sync empty WAL log in backup")
        file_unlock(engine.lockFd)
        noeWalEngineClose(&engine)
        fs_remove_tree(stagingPath)
        return -71 as isize
    }

    let s1: isize = fs_directory_sync(stagingPath + "/versions")
    let s2: isize = fs_directory_sync(stagingPath)
    if s1 < 0 as isize || s2 < 0 as isize {
        print("[-] Failed to sync backup directory")
        file_unlock(engine.lockFd)
        noeWalEngineClose(&engine)
        fs_remove_tree(stagingPath)
        return -8 as isize
    }

    // Atomically publish completed backup
    let renRes: isize = fs_rename(stagingPath, targetPath)
    if renRes < 0 as isize {
        print("[-] Failed to publish backup atomically")
        file_unlock(engine.lockFd)
        noeWalEngineClose(&engine)
        fs_remove_tree(stagingPath)
        return -9 as isize
    }
    let sTgt: isize = noeWalSyncDirectory(targetPath)
    if sTgt < 0 as isize {
        print("[-] Failed to sync target backup directory")
        file_unlock(engine.lockFd)
        noeWalEngineClose(&engine)
        return -91 as isize
    }

    // Now release source lock and close engine
    file_unlock(engine.lockFd)
    file_close(engine.walFd)
    file_close(engine.lockFd)
    engine.walOpen = false

    // Verify backup target can be opened and passes checksum verification
    let verifyEngine: NoeWalEngine
    let vRes: isize = noeWalEngineOpen(&verifyEngine, targetPath)
    if vRes != 0 as isize {
        print("[-] Backup verification failed on target (Status: " + noeIntToString(vRes as i64) + ")")
        fs_remove_tree(targetPath)
        return vRes
    }
    noeWalEngineClose(&verifyEngine)

    print("[+] Point-in-Time Backup Created & Verified: " + targetPath)
    print("    Generation: " + noeIntToString(currentGen as i64))
    print("    Status: SUCCESS\n")
    return 0 as isize
}

export function noeCliRestore(backupPath: string, targetPath: string): isize {
    if backupPath == "" || targetPath == "" {
        print("[-] Usage: noesql restore <backupPath> <targetDb>")
        return -1 as isize
    }
    if !fs_exists(backupPath) {
        print("[-] Backup directory does not exist: " + backupPath)
        return -2 as isize
    }
    if fs_exists(targetPath) {
        print("[-] Target restore path already exists (refusing to overwrite): " + targetPath)
        return -3 as isize
    }

    print("[*] Initiating verified restore...")
    let bRes: isize = noeCliBackup(backupPath, targetPath)
    if bRes != 0 as isize {
        print("[-] Restore failed (Status: " + noeIntToString(bRes as i64) + ")")
        return bRes
    }
    print("[+] Database Restored Successfully to: " + targetPath + "\n")
    return 0 as isize
}

export function noeCliExplain(dbPath: string, stmt: string): isize {
    if dbPath == "" || stmt == "" {
        print("[-] Usage: noesql explain <dbPath> '<statement>'")
        return -1 as isize
    }

    print("================================================================")
    print("  NoeSQL Query Plan Inspector (EXPLAIN)")
    print("  Target Database: " + dbPath)
    print("  Statement: " + stmt)
    print("================================================================")

    let engine: NoeWalEngine
    let oRes: isize = noeWalEngineOpen(&engine, dbPath)
    if oRes != 0 as isize {
        print("[-] EXPLAIN Failed: Could not open database (Status: " + noeIntToString(oRes as i64) + ")")
        return oRes
    }

    // Tokenize statement to extract target table, predicate column, and comparison value
    let buf: [u8; 1024]
    let sLen: usize = stringToBytes(stmt, &buf[0], 1024 as usize)
    let cur: usize = 0 as usize

    let firstTok: string = noeParseToken(&buf[0], sLen, &cur)
    let tblName: string = ""
    let colName: string = ""
    let condVal: string = ""

    if firstTok == "SELECT" || firstTok == "select" {
        while cur < sLen {
            let tok: string = noeParseToken(&buf[0], sLen, &cur)
            if tok == "FROM" || tok == "from" {
                tblName = noeParseToken(&buf[0], sLen, &cur)
            } else if tok == "WHERE" || tok == "where" {
                colName = noeParseToken(&buf[0], sLen, &cur)
                let op: string = noeParseToken(&buf[0], sLen, &cur)
                condVal = noeParseToken(&buf[0], sLen, &cur)
                break
            }
        }
    } else {
        tblName = firstTok
        let nextTok: string = noeParseToken(&buf[0], sLen, &cur)
        if nextTok == "where" || nextTok == "get" {
            colName = noeParseToken(&buf[0], sLen, &cur)
            let op: string = noeParseToken(&buf[0], sLen, &cur)
            condVal = noeParseToken(&buf[0], sLen, &cur)
        }
    }

    if tblName == "" {
        print("[-] EXPLAIN Failed: Could not identify target table in statement")
        noeWalEngineClose(&engine)
        return -1 as isize
    }

    // Verify table exists in actual catalog
    let tIdx: isize = noeFindTable(&engine.db, tblName)
    if tIdx < 0 as isize {
        print("[-] EXPLAIN Failed: Referenced table '" + tblName + "' does not exist in schema catalog")
        noeWalEngineClose(&engine)
        return -2 as isize
    }
    let t: *NoeTableData = &engine.db.tables[tIdx as usize]

    // If a filter column was specified, verify it exists in table schema
    let colIdx: isize = -1 as isize
    if colName != "" {
        colIdx = noeFindField(&engine.db, tIdx as usize, colName)
        if colIdx < 0 as isize {
            print("[-] EXPLAIN Failed: Referenced column '" + colName + "' does not exist in table '" + tblName + "'")
            noeWalEngineClose(&engine)
            return -3 as isize
        }
    }

    // Check whether this query executes via B+Tree index lookup vs full-table scan
    let isIndexScan: bool = false
    if colIdx >= 0 as isize {
        let fDef: *NoeFieldDef = &t.fields[colIdx as usize]
        // Table 0 primary key is indexed by engine.primaryIndex (or fields with key/unique)
        if tIdx == 0 as usize && (colIdx == 0 as isize || fDef.isKey) {
            isIndexScan = true
        }
    }

    if isIndexScan {
        print("[+] PLAN: INDEX_SCAN")
        print("    Operator: B+Tree Primary Key Index Lookup (noeBTreeSearch)")
        print("    Target Table: " + tblName)
        print("    Index: pk_btree_idx (" + tblName + "." + colName + ")")
        print("    Predicate: " + colName + " == " + condVal)
        print("    Complexity: O(log N)")
        print("    Estimated Cost: 1.0 (Logarithmic root-to-leaf traversal, zero full-table iteration)")
        print("    Estimated Rows: 1")
    } else {
        print("[*] PLAN: TABLE_SCAN")
        print("    Operator: Sequential Full-Table Scan (noeScanRows)")
        print("    Target Table: " + tblName)
        if colName != "" {
            print("    Reason: Column '" + colName + "' does not possess an active B+Tree index")
            print("    Predicate: " + colName + " == " + condVal)
        } else {
            print("    Reason: Unindexed scan across all rows")
        }
        print("    Complexity: O(N)")
        print("    Estimated Cost: " + noeIntToString(t.rowCount as i64) + ".0 (Linear scan across " + noeIntToString(t.rowCount as i64) + " table rows)")
        print("    Estimated Rows: " + noeIntToString(t.rowCount as i64))
    }
    print("================================================================\n")

    noeWalEngineClose(&engine)
    return 0 as isize
}

export function noeCliQuery(dbPath: string, stmt: string): isize {
    if dbPath == "" || stmt == "" {
        print("[-] Usage: noesql query <dbPath> '<statement>'")
        return -1 as isize
    }

    let engine: NoeWalEngine
    let oRes: isize = noeWalEngineOpen(&engine, dbPath)
    if oRes != 0 as isize {
        print("ERROR:open_failed:" + noeIntToString(oRes as i64))
        return oRes
    }

    let res: string = noeDaemonHandleRequest(&engine, stmt)
    print(res)

    noeWalEngineClose(&engine)

    // Check res for error or uncertain commit to propagate non-zero exit status
    let buf: [u8; 64]
    let sLen: usize = stringToBytes(res, &buf[0], 64 as usize)
    if sLen >= 6 as usize && buf[0] == 69 as u8 && buf[1] == 82 as u8 && buf[2] == 82 as u8 &&
       buf[3] == 79 as u8 && buf[4] == 82 as u8 && buf[5] == 58 as u8 { // "ERROR:"
        return -1 as isize
    }
    if sLen >= 16 as usize && buf[0] == 85 as u8 && buf[1] == 78 as u8 && buf[2] == 67 as u8 &&
       buf[3] == 69 as u8 && buf[4] == 82 as u8 && buf[5] == 84 as u8 { // "UNCERTAIN_COMMIT"
        return -2 as isize
    }

    return 0 as isize
}

export function noeCliDispatch(reqPath: string, statusPath: string): isize {
    let cmd: string = noeCliReadLine(reqPath, 0 as usize)
    if cmd == "" {
        print("NoeSQL CLI Runner: missing or empty request file " + reqPath)
        noeCliWriteStatusFile(statusPath, -1 as isize)
        return -1 as isize
    }

    let arg1: string = noeCliReadLine(reqPath, 1 as usize)
    let arg2: string = noeCliReadLine(reqPath, 2 as usize)
    let arg3: string = noeCliReadLine(reqPath, 3 as usize)

    let status: isize = 0 as isize
    if cmd == "doctor" {
        status = noeCliDoctor(arg1)
    } else if cmd == "check" {
        status = noeCliCheck(arg1)
    } else if cmd == "backup" {
        status = noeCliBackup(arg1, arg2)
    } else if cmd == "restore" {
        status = noeCliRestore(arg1, arg2)
    } else if cmd == "explain" {
        status = noeCliExplain(arg1, arg2)
    } else if cmd == "query" {
        status = noeCliQuery(arg1, arg2)
    } else {
        print("Unknown command: " + cmd)
        status = -1 as isize
    }
    noeCliWriteStatusFile(statusPath, status)
    return status
}
