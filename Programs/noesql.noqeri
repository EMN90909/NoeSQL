import "../Database/noesql_engine.noqeri"
import "../../Noqeri/Lib/std/file.noqeri"
import "../../Noqeri/Lib/std/fs.noqeri"

function assert_true(cond: bool, msg: string): void {
    if !cond {
        print("FATAL ERROR: " + msg)
        let trap: *u8 = 0 as *u8
        print(trap[0])
    }
}

function main(): void {
    print("================================================================")
    print("  NoeSQL Database Engine (Pure Noqeri Native Execution)")
    print("  Engine Version: " + noeEngineVersion())
    print("  Runtime Architecture: Zero Rust / Zero Zig / Pure .noqeri")
    print("================================================================\n")

    let dbPath: string = "production.noedb"

    // If database already exists on disk, perform genuine cold reopen
    let db: NoeDatabaseState
    if fs_exists(dbPath + "/HEAD") {
        print("[*] Existing database detected. Performing cold reopening from disk...")
        let openStatus: isize = noeDbOpenV3(&db, dbPath)
        print("openStatus: " + intToString(openStatus as i64))
        assert_true(openStatus == 0 as isize, "cold reopen existing database")
        print("  Reopened generation " + intToString(db.generation as i64) + " with " + intToString(db.tableCount as i64) + " tables.")
    } else {
        print("[1/6] Initializing relational schema...")
        noeEngineInit(&db, "main")

        let deptIdx: isize = noeCreateTable(&db, "departments")
        assert_true(deptIdx >= 0 as isize, "create departments table")
        noeAddField(&db, deptIdx as usize, "id", noeTypeInt(), true, true, true, true, "")
        noeAddField(&db, deptIdx as usize, "name", noeTypeText(), true, true, false, false, "")

        let userIdx: isize = noeCreateTable(&db, "users")
        assert_true(userIdx >= 0 as isize, "create users table")
        noeAddField(&db, userIdx as usize, "id", noeTypeInt(), true, true, true, true, "")
        noeAddField(&db, userIdx as usize, "username", noeTypeText(), true, true, false, false, "")
        noeAddField(&db, userIdx as usize, "dept_id", noeTypeInt(), true, false, false, false, "departments")

        print("  Created tables: 'departments', 'users'")

        print("[2/6] Inserting records and enforcing foreign keys...")
        let d1: [NoeRowCell; 2]
        d1[0].isNull = true // auto
        d1[1].isNull = false
        d1[1].textVal = "Core Engineering"
        assert_true(noeInsertRow(&db, deptIdx as usize, slice(d1)) == 0 as isize, "insert dept 1")

        let d2: [NoeRowCell; 2]
        d2[0].isNull = true // auto
        d2[1].isNull = false
        d2[1].textVal = "Deep Research"
        assert_true(noeInsertRow(&db, deptIdx as usize, slice(d2)) == 0 as isize, "insert dept 2")

        let u1: [NoeRowCell; 3]
        u1[0].isNull = true // auto
        u1[1].isNull = false
        u1[1].textVal = "alice"
        u1[2].isNull = false
        u1[2].intVal = 1 as i64
        assert_true(noeInsertRow(&db, userIdx as usize, slice(u1)) == 0 as isize, "insert user alice")

        let u2: [NoeRowCell; 3]
        u2[0].isNull = true // auto
        u2[1].isNull = false
        u2[1].textVal = "bob"
        u2[2].isNull = false
        u2[2].intVal = 2 as i64
        assert_true(noeInsertRow(&db, userIdx as usize, slice(u2)) == 0 as isize, "insert user bob")

        print("  Inserted departments and users with verified foreign-key constraints.")

        print("[3/6] Persisting database generation to disk (fsync + atomic commit)...")
        let saveRes: isize = noeDbSaveV3(&db, dbPath)
        assert_true(saveRes == 0 as isize, "v3 durable commit")
        print("  Committed generation snapshot to " + dbPath)
    }

    // ------------------------------------------------------------------------
    // Step 4: Genuine Cold Reopening into a completely fresh uninitialized state
    // ------------------------------------------------------------------------
    print("[4/6] Verifying genuine cold reopen (disk-to-memory reconstruction)...")
    let coldDb: NoeDatabaseState
    let coldStatus: isize = noeDbOpenV3(&coldDb, dbPath)
    print("coldStatus: " + intToString(coldStatus as i64))
    assert_true(coldStatus == 0 as isize, "disk-to-memory reconstruction succeeded")
    assert_true(coldDb.tableCount == 2 as usize, "reconstructed 2 tables")
    assert_true(coldDb.tables[0].name == "departments", "reconstructed table 'departments'")
    assert_true(coldDb.tables[1].name == "users", "reconstructed table 'users'")
    assert_true(coldDb.tables[1].rowCount == 2 as usize, "reconstructed 2 users")

    let uTable: *NoeTableData = &coldDb.tables[1]
    let aliceCell: *NoeRowCell = &uTable.cells[0 * 16 as usize + 1 as usize]
    let bobCell: *NoeRowCell = &uTable.cells[1 * 16 as usize + 1 as usize]
    assert_true(aliceCell.textVal == "alice", "Alice record verified from cold disk reconstruction")
    assert_true(bobCell.textVal == "bob", "Bob record verified from cold disk reconstruction")

    print("  Successfully deserialized records from cold storage:")
    print("    -> " + aliceCell.textVal)
    print("    -> " + bobCell.textVal)

    // ------------------------------------------------------------------------
    // Step 5: Relational Foreign Key Constraint Verification
    // ------------------------------------------------------------------------
    print("[5/6] Verifying relational delete protection on reconstructed data...")
    let delDept1: isize = noeDeleteRow(&coldDb, 0 as usize, 0 as usize)
    assert_true(delDept1 == -208 as isize, "delete of referenced department blocked by foreign key constraint")
    print("  Verified: Foreign key prevented orphaned references on delete.")

    // ------------------------------------------------------------------------
    // Step 6: Backup and Point-in-Time Recovery
    // ------------------------------------------------------------------------
    print("[6/6] Verifying backup and point-in-time recovery...")
    let backupDir: string = "production.backup"
    let restoreDir: string = "production.restored"
    fs_remove_tree(backupDir)
    fs_remove_tree(restoreDir)

    assert_true(noeDbBackup(&coldDb, dbPath, backupDir) == 0 as isize, "backup generation created")
    assert_true(noeDbRestore(&coldDb, backupDir, restoreDir) == 0 as isize, "database restored from backup")

    // Reopen restored database into another fresh state to verify 100% reconstruction parity
    let restoredDb: NoeDatabaseState
    assert_true(noeDbOpenV3(&restoredDb, restoreDir) == 0 as isize, "restored database deserialization")
    assert_true(restoredDb.tables[1].cells[0 * 16 as usize + 1 as usize].textVal == "alice", "Alice recovered in restored database")
    assert_true(restoredDb.tables[1].cells[1 * 16 as usize + 1 as usize].textVal == "bob", "Bob recovered in restored database")

    print("  Point-in-time recovery and record parity verified.")

    // Clean up temporary backup/restore test directories
    fs_remove_tree(backupDir)
    fs_remove_tree(restoreDir)

    print("\n================================================================")
    print("  NoeSQL Pure Noqeri Database Engine: ALL OPERATIONS VERIFIED")
    print("================================================================\n")
}

main()
