#!/bin/bash
set -euo pipefail

# NoeSQL Standalone Native Execution Runner
if [ -n "${NOQERI:-}" ] && [ -x "$NOQERI" ]; then
    NOQERI_BIN="$NOQERI"
elif [ -x "/home/antigravity/EMN90909/Noqeri/build/noqeri" ]; then
    NOQERI_BIN="/home/antigravity/EMN90909/Noqeri/build/noqeri"
elif command -v noqeri >/dev/null 2>&1; then
    NOQERI_BIN="$(command -v noqeri)"
else
    echo "Error: noqeri runtime executable not found" >&2
    exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# If no arguments or 'test', run the standard test suite
if [ $# -eq 0 ] || [ "$1" = "test" ]; then
    shift $(( $# > 0 ? 1 : 0 ))
    exec "$NOQERI_BIN" run "$SCRIPT_DIR/Programs/noesql.noqeri" "$@"
fi

CMD="$1"
shift

case "$CMD" in
    doctor|check|backup|restore|explain|query)
        PID="$$"
        ARG_FILE="/tmp/.noesql_cli_cmd_${PID}.txt"
        STATUS_FILE="/tmp/.noesql_cli_status_${PID}.txt"
        RUNNER_FILE="$SCRIPT_DIR/Programs/.noesql_runner_${PID}.noqeri"

        cleanup() {
            rm -f "$ARG_FILE" "$STATUS_FILE" "$RUNNER_FILE"
        }
        trap cleanup EXIT INT TERM

        printf "%s\n" "$CMD" > "$ARG_FILE"
        for arg in "$@"; do
            printf "%s\n" "$arg" >> "$ARG_FILE"
        done

        cat <<EOF > "$RUNNER_FILE"
import "./noesql_cli.noqeri"

function main(): void {
    let req: string = "$ARG_FILE"
    let status: string = "$STATUS_FILE"
    noeCliDispatch(req, status)
}

main()
EOF

        "$NOQERI_BIN" run "$RUNNER_FILE"
        EXIT_CODE=0
        if [ -f "$STATUS_FILE" ]; then
            STATUS_VAL="$(cat "$STATUS_FILE" | tr -d ' \r\n')"
            if [ -n "$STATUS_VAL" ] && [ "$STATUS_VAL" != "0" ]; then
                EXIT_CODE=1
            fi
        else
            EXIT_CODE=1
        fi
        exit $EXIT_CODE
        ;;
    help|--help|-h)
        echo "NoeSQL - Relational Database Management System (Pure Noqeri)"
        echo ""
        echo "Usage:"
        echo "  noesql test                            Run built-in verification suite"
        echo "  noesql doctor [db_path]                Run deep integrity & health check"
        echo "  noesql check [db_path]                 Verify relational & index integrity"
        echo "  noesql backup <src_path> <target_path> Create consistent point-in-time backup"
        echo "  noesql restore <backup_path> <target>  Safely restore from verified backup"
        echo "  noesql explain <db_path> <query>       Inspect query execution plan (O(log N) vs O(N))"
        echo "  noesql query <db_path> <statement>     Execute a statement or transaction"
        echo "  noesql help                            Show this help message"
        exit 0
        ;;
    *)
        echo "Error: Unknown command '$CMD'" >&2
        echo "Run 'noesql help' for usage instructions." >&2
        exit 1
        ;;
esac
